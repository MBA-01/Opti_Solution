# Canonical production URL used by metadata, robots.txt, and sitemap generation.
PUBLIC_SITE_URL=https://example.com

# Lead delivery endpoint. The form redirects to /merci only after an HTTP 2xx response.
PUBLIC_DEMO_FORM_ENDPOINT=

# Optional GA4 measurement ID. Google Analytics remains disabled when empty.
PUBLIC_GOOGLE_ANALYTICS_ID=

# A complete address activates ProfessionalService (LocalBusiness) structured data.
PUBLIC_BUSINESS_STREET=
PUBLIC_BUSINESS_CITY=
PUBLIC_BUSINESS_POSTAL_CODE=
PUBLIC_BUSINESS_COUNTRY=MA
