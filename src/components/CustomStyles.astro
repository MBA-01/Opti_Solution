---
// System fonts keep the preview independent of remote font downloads.
---

<style is:inline>
  :root {
    --os-forest-900: #0b2e26;
    --os-forest-800: #0f3d32;
    --os-forest-700: #185548;
    --os-forest-100: #e6efea;
    --os-cream-50: #f8f5ed;
    --os-surface: #fffdf8;
    --os-ink-900: #1f1f1f;
    --os-ink-600: #5d625f;
    --os-gold-400: #c9a96b;
    --os-gold-700: #806735;
    --os-line: #d9d7cf;
    --os-radius-sm: 0.72rem;
    --os-radius-md: 1.15rem;
    --os-radius-lg: 1.65rem;
    /* Soft elevation ramp generated from https://www.depths.studio/. */
    --os-shadow-raised: 0 1px 2.6px rgb(0 0 0 / 0.07), 0 0.4px 5.7px rgb(0 0 0 / 0.046);
    --os-shadow-hover: 0 1.9px 4.9px rgb(0 0 0 / 0.067), 0 0.7px 10.9px rgb(0 0 0 / 0.043);
    --os-shadow-sticky: 0 1.9px 4.9px rgb(0 0 0 / 0.067), 0 0.7px 10.9px rgb(0 0 0 / 0.043);
    --os-shadow-dropdown: 0 3.6px 9.4px rgb(0 0 0 / 0.063), 0 1.3px 20.6px rgb(0 0 0 / 0.041);
    --os-shadow-modal: 0 6.9px 17.8px rgb(0 0 0 / 0.06), 0 2.4px 39.2px rgb(0 0 0 / 0.039);
    --os-shadow-toast: 0 13px 33.9px rgb(0 0 0 / 0.057), 0 4.6px 74.5px rgb(0 0 0 / 0.037);
    --os-shadow-pressed: inset 0 0.8px 2.5px rgb(0 0 0 / 0.091);
    --os-edge-raised: 1px solid rgb(0 0 0 / 0.075);
    --os-edge-hover: 1px solid rgb(0 0 0 / 0.09);
    --os-edge-sticky: 1px solid rgb(0 0 0 / 0.09);
    --os-edge-dropdown: 1px solid rgb(0 0 0 / 0.105);
    --os-edge-modal: 1px solid rgb(0 0 0 / 0.12);
    --os-edge-toast: 1px solid rgb(0 0 0 / 0.135);
    --os-shadow-sm: var(--os-shadow-raised);
    --os-shadow-md: var(--os-shadow-dropdown);
    --os-shadow-lg: var(--os-shadow-modal);

    /* Entrance/exit curves and semantic durations from https://www.springs.studio/. */
    --os-ease: cubic-bezier(0.2, 0, 0, 1);
    --os-ease-enter: cubic-bezier(0.2, 0, 0, 1);
    --os-ease-exit: cubic-bezier(1, 0, 0.8, 1);
    --os-motion-subtle-enter: 140ms;
    --os-motion-subtle-exit: 98ms;
    --os-motion-standard-enter: 200ms;
    --os-motion-standard-exit: 140ms;
    --os-motion-emphasized-enter: 280ms;
    --os-motion-emphasized-exit: 196ms;
    --os-motion-scroll-enter: var(--os-motion-emphasized-enter);
    --os-motion-stagger: 40ms;

    --aw-font-sans: Inter, system-ui, sans-serif;
    --aw-font-serif: Georgia, 'Times New Roman', serif;
    --aw-font-heading: Georgia, 'Times New Roman', serif;

    --aw-color-primary: var(--os-forest-800);
    --aw-color-secondary: var(--os-forest-700);
    --aw-color-accent: var(--os-gold-400);

    --aw-color-text-heading: var(--os-ink-900);
    --aw-color-text-default: var(--os-ink-900);
    --aw-color-text-muted: var(--os-ink-600);
    --aw-color-bg-page: var(--os-cream-50);

    --aw-color-bg-page-dark: var(--os-forest-900);

    ::selection {
      background-color: var(--os-forest-100);
    }
  }

  @media (max-width: 767px) {
    :root {
      /* Give touch-sized layouts more time to resolve staged content. */
      --os-motion-scroll-enter: 420ms;
      --os-motion-stagger: 55ms;
    }
  }

  .dark {
    --aw-font-sans: Inter, system-ui, sans-serif;
    --aw-font-serif: Georgia, 'Times New Roman', serif;
    --aw-font-heading: Georgia, 'Times New Roman', serif;

    --aw-color-primary: #f8f5ed;
    --aw-color-secondary: #e6efea;
    --aw-color-accent: #c9a96b;

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(8 9 10);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
