---
import Button from '~/components/ui/Button.astro';
---

<section class="os-device-showcase" aria-labelledby="device-showcase-title">
  <div class="os-container os-device-showcase__grid">
    <div class="os-device-showcase__copy">
      <p class="os-eyebrow">Formats montrés</p>
      <h2 id="device-showcase-title">Un tableau de bord cadré pour trois formats.</h2>
      <p>
        Ces aperçus illustrent seulement l’organisation du tableau de bord présentée sur ordinateur, tablette et
        téléphone. La démonstration sert à vérifier chaque écran et chaque action nécessaire à votre équipe.
      </p>
      <div class="os-device-showcase__list" aria-label="Limites de la preuve">
        <span>Tableau de bord illustré</span><span>Trois formats montrés</span>
      </div>
      <div class="os-actions">
        <Button variant="secondary" href="/fonctionnalites" text="Découvrir l’interface" icon="tabler:arrow-right" />
      </div>
    </div>

    <figure class="os-device-showcase__visual">
      <button
        class="os-device-showcase__preview"
        type="button"
        data-product-preview
        data-src="/product/device-showcase.png"
        data-alt="Tableau de bord OptiSolution présenté sur un ordinateur, une tablette et un téléphone."
        data-caption="OptiSolution · aperçu multi-écran"
        aria-label="Agrandir l’aperçu multi-écran d’OptiSolution"
      >
        <img
          src="/product/device-showcase.png"
          alt="Tableau de bord OptiSolution présenté sur un ordinateur, une tablette et un téléphone."
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
        />
      </button>
    </figure>
  </div>
</section>

<style>
  .os-device-showcase {
    overflow: clip;
    padding-block: clamp(5rem, 9vw, 8rem);
    background: radial-gradient(circle at 82% 20%, rgb(201 169 107 / 0.14), transparent 23rem), var(--os-forest-900);
  }

  .os-device-showcase__grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(32rem, 1.28fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .os-device-showcase__copy {
    position: relative;
    z-index: 4;
  }

  .os-device-showcase h2 {
    max-width: 38rem;
    margin: 0;
    color: white;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.7rem, 5vw, 4.9rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .os-device-showcase__copy > p:not(.os-eyebrow) {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: rgb(248 245 237 / 0.72);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .os-device-showcase__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.5rem;
  }

  .os-device-showcase__list span {
    border-radius: 999px;
    padding: 0.45rem 0.7rem;
    color: var(--os-cream-50);
    background: rgb(248 245 237 / 0.08);
    font-size: 0.73rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }

  .os-device-showcase :global(.btn-secondary) {
    border-color: rgb(248 245 237 / 0.35);
    color: white;
    background: rgb(248 245 237 / 0.06);
  }

  .os-device-showcase__visual {
    --os-frame-padding: clamp(0.35rem, 0.7vw, 0.5rem);
    --os-frame-radius: clamp(1.25rem, 2.4vw, 1.75rem);

    position: relative;
    z-index: 0;
    margin: 0;
    padding: var(--os-frame-padding);
    border-radius: var(--os-frame-radius);
    background: linear-gradient(145deg, rgb(248 245 237 / 0.15), rgb(248 245 237 / 0.035));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      var(--os-shadow-modal);
  }

  .os-device-showcase__visual::before {
    position: absolute;
    z-index: 0;
    inset: 6% -5% -10%;
    border-radius: 45%;
    background:
      radial-gradient(ellipse at 72% 42%, rgb(201 169 107 / 0.2), transparent 64%),
      radial-gradient(ellipse at 30% 55%, rgb(248 245 237 / 0.07), transparent 58%);
    content: '';
    filter: blur(24px);
    pointer-events: none;
  }

  .os-device-showcase__preview {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 0;
    border-radius: calc(var(--os-frame-radius) - var(--os-frame-padding));
    padding: 0;
    background: var(--os-forest-900);
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.14),
      0 1rem 2.5rem rgb(0 0 0 / 0.2);
    cursor: zoom-in;
    transition:
      transform var(--os-duration-emphasized) var(--os-ease-enter),
      box-shadow var(--os-duration-standard) var(--os-ease-enter);
  }

  .os-device-showcase__preview:focus-visible {
    outline: 3px solid var(--os-cream-50);
    outline-offset: 4px;
  }

  .os-device-showcase__preview img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--os-duration-emphasized) var(--os-ease-enter);
  }

  .os-device-showcase__preview:hover {
    transform: translateY(-0.2rem) scale(1.005);
    box-shadow: var(--os-shadow-modal);
  }

  .os-device-showcase__preview:hover img {
    transform: scale(1.012);
  }

  @media (max-width: 1023px) {
    .os-device-showcase__grid {
      grid-template-columns: 1fr;
    }

    .os-device-showcase__visual {
      width: min(100%, 46rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 767px) {
    .os-device-showcase__visual {
      --os-frame-padding: 0.3rem;
      --os-frame-radius: 1.2rem;

      box-shadow: 0 1.4rem 3rem rgb(0 0 0 / 0.28);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .os-device-showcase__preview,
    .os-device-showcase__preview img {
      transition: none;
    }

    .os-device-showcase__preview:hover,
    .os-device-showcase__preview:hover img {
      transform: none;
    }
  }
</style>
