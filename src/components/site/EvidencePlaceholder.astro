---
interface Props {
  label?: string;
  title: string;
  text?: string;
}

const {
  label = 'Démonstration guidée',
  title,
  text = 'Nous montrons cette étape avec des données préparées pendant la démonstration. Aucune capture publique non validée n’est utilisée.',
} = Astro.props;
---

<aside class="os-evidence-placeholder" aria-label={`${label} : ${title}`}>
  <span>{label}</span>
  <strong>{title}</strong>
  <p>{text}</p>
  <div aria-hidden="true"><i></i><i></i><i></i></div>
</aside>

<style>
  .os-evidence-placeholder {
    position: relative;
    display: grid;
    min-height: 19rem;
    align-content: end;
    overflow: hidden;
    border: 1px solid var(--os-line);
    border-radius: var(--os-radius-md);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    background:
      radial-gradient(circle at 80% 15%, rgb(201 169 107 / 0.2), transparent 12rem),
      linear-gradient(145deg, var(--os-forest-900), var(--os-forest-700));
    box-shadow: var(--os-shadow-md);
  }

  .os-evidence-placeholder span {
    color: var(--os-gold-400);
    font-size: 0.73rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .os-evidence-placeholder strong {
    max-width: 24rem;
    margin-top: 0.7rem;
    color: white;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.7rem, 4vw, 2.7rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .os-evidence-placeholder p {
    max-width: 34rem;
    margin: 0.8rem 0 0;
    color: rgb(248 245 237 / 0.72);
    line-height: 1.6;
  }

  .os-evidence-placeholder div {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    display: flex;
    gap: 0.35rem;
  }

  .os-evidence-placeholder i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgb(248 245 237 / 0.28);
  }
</style>
