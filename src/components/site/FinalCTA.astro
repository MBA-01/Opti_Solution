---
import Button from '~/components/ui/Button.astro';

interface Props {
  title?: string;
  text?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  title = 'Voyez Opti Solution sur les parcours qui comptent pour vous.',
  text = 'Indiquez-nous vos priorités. Nous préparerons une démonstration guidée pour évaluer l’adéquation avec votre magasin et préciser le périmètre à étudier.',
  secondaryText = 'Écrire sur WhatsApp',
  secondaryHref = 'https://wa.me/212620169713',
} = Astro.props;
---

<section class="os-final-cta">
  <div class="os-container os-final-cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="os-final-cta__action-group">
      <div class="os-actions">
        <Button
          variant="primary"
          href="/demo#demande"
          text="Demander une démo"
          icon="tabler:arrow-right"
          data-analytics-event="cta_click"
          data-analytics-label="final_demo"
        />
        <Button variant="secondary" href={secondaryHref} text={secondaryText} target="_blank" />
      </div>
      <p class="os-cta-assurance os-cta-assurance--light"><span aria-hidden="true"></span> Réponse sous 1 jour ouvré</p>
    </div>
  </div>
</section>
