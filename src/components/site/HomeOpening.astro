---
import Button from '~/components/ui/Button.astro';
---
<section class="os-cinema-hero" aria-labelledby="home-title">
  <div class="os-cinema-hero__glow" aria-hidden="true"></div>
  <div class="os-container os-cinema-hero__grid">
    <div class="os-cinema-hero__copy">
      <p class="os-eyebrow">Optical care, connected</p>
      <h1 id="home-title">From vision<br /><em>to clarity.</em></h1>
      <p class="os-lead">OptiSolution connects eye care, eyewear, retail operations, and management into one calm, precise system.</p>
      <div class="os-actions">
        <Button variant="primary" href="/demo#demande" text="Request a demo" icon="tabler:arrow-up-right" />
        <a class="os-cinema-link" href="#story">Explore the platform <span aria-hidden="true">↓</span></a>
      </div>
      <div class="os-cinema-proof"><span>01</span><span>Precision for modern optical care</span></div>
    </div>
    <div class="os-lens-stage" aria-label="Abstract optical lens illustration" role="img">
      <div class="os-lens-stage__orbit os-lens-stage__orbit--one"></div>
      <div class="os-lens-stage__orbit os-lens-stage__orbit--two"></div>
      <div class="os-lens">
        <div class="os-lens__shine"></div><div class="os-lens__iris"></div><div class="os-lens__core"></div>
      </div>
      <span class="os-lens-stage__label os-lens-stage__label--top">optical / 01</span>
      <span class="os-lens-stage__label os-lens-stage__label--bottom">clarity, connected</span>
    </div>
  </div>
  <div class="os-scroll-cue" aria-hidden="true"><span></span> Scroll to discover</div>
</section>
<section class="os-proof-band os-proof-band--cinema" aria-label="OptiSolution at a glance">
  <div class="os-container os-proof-band__grid"><div><strong>One connected journey</strong><p>From examination to delivery.</p></div><div><strong>Built for optical teams</strong><p>Context where it matters.</p></div><div><strong>Designed for confidence</strong><p>Clearer work, better care.</p></div></div>
</section>
---

<style>
  .os-cinema-hero { position: relative; overflow: hidden; min-height: calc(100svh - 72px); display: grid; align-items: center; background: #f7f4ec; }
  .os-cinema-hero__glow { position: absolute; width: 60vw; height: 60vw; right: -14vw; top: 4%; border-radius: 50%; background: radial-gradient(circle, rgb(199 214 204 / .7), transparent 65%); filter: blur(3px); }
  .os-cinema-hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, .85fr) minmax(25rem, 1.15fr); align-items: center; gap: 2rem; padding-block: clamp(5rem, 10vw, 8rem); }
  .os-cinema-hero__copy { max-width: 38rem; }
  .os-cinema-hero h1 { margin: 0; color: var(--os-ink-900); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(4.5rem, 9vw, 8.8rem); font-weight: 500; letter-spacing: -.075em; line-height: .82; }
  .os-cinema-hero h1 em { color: var(--os-forest-800); font-style: italic; }
  .os-cinema-hero .os-lead { max-width: 31rem; margin-top: 2rem; }
  .os-cinema-link { display: inline-flex; align-items: center; gap: .55rem; color: var(--os-forest-800); font-size: .95rem; font-weight: 700; }
  .os-cinema-link span { transition: transform .2s; } .os-cinema-link:hover span { transform: translateY(3px); }
  .os-cinema-proof { display: flex; gap: .8rem; align-items: center; margin-top: clamp(4rem, 8vw, 7rem); color: var(--os-ink-600); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; }
  .os-cinema-proof span:first-child { color: var(--os-gold-700); }
  .os-lens-stage { position: relative; min-height: min(640px, 68vw); display: grid; place-items: center; }
  .os-lens { position: relative; width: min(34vw, 32rem); aspect-ratio: 1; border: 1px solid rgb(15 61 50 / .35); border-radius: 50%; background: radial-gradient(circle at 34% 28%, rgb(255 255 255 / .95), transparent 14%), radial-gradient(circle at 60% 62%, #b4d0c1 0 8%, #6d9b8d 18%, #245e50 49%, #0c3029 78%); box-shadow: inset -25px -30px 55px rgb(3 28 23 / .45), inset 18px 14px 40px rgb(255 255 255 / .48), 0 35px 100px rgb(15 61 50 / .2); transform: rotate(-14deg); animation: osLensFloat 9s ease-in-out infinite; }
  .os-lens::before { content: ''; position: absolute; inset: 7%; border: 1px solid rgb(255 255 255 / .45); border-radius: 50%; }
  .os-lens__shine { position: absolute; inset: 9% 18% 53% 11%; border-radius: 50%; background: linear-gradient(125deg, rgb(255 255 255 / .76), transparent 60%); filter: blur(1px); transform: rotate(-25deg); }
  .os-lens__iris { position: absolute; inset: 26%; border: 1px solid rgb(218 238 225 / .5); border-radius: 50%; background: repeating-conic-gradient(from 15deg, rgb(231 244 234 / .28) 0 2deg, transparent 2deg 13deg); box-shadow: 0 0 35px rgb(187 230 204 / .3); }
  .os-lens__core { position: absolute; inset: 39%; border: 1px solid rgb(249 246 235 / .7); border-radius: 50%; background: #173f35; box-shadow: 0 0 20px rgb(217 235 219 / .5); }
  .os-lens-stage__orbit { position: absolute; width: 90%; height: 38%; border: 1px solid rgb(15 61 50 / .19); border-radius: 50%; transform: rotate(-29deg); }
  .os-lens-stage__orbit--two { width: 76%; height: 60%; transform: rotate(57deg); border-color: rgb(201 169 107 / .42); }
  .os-lens-stage__label { position: absolute; color: var(--os-ink-600); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; }
  .os-lens-stage__label--top { top: 15%; right: 8%; } .os-lens-stage__label--bottom { bottom: 14%; left: 5%; }
  .os-scroll-cue { position: absolute; bottom: 1.5rem; left: 50%; display: flex; align-items: center; gap: .6rem; color: var(--os-ink-600); font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; transform: translateX(-50%); }
  .os-scroll-cue span { display: block; width: 1px; height: 2.5rem; background: var(--os-gold-700); }
  .os-proof-band--cinema { background: var(--os-forest-900); color: var(--os-cream-50); } .os-proof-band--cinema p { color: rgb(248 245 237 / .62); }
  @keyframes osLensFloat { 0%,100% { translate: 0 0; } 50% { translate: 0 -14px; } }
  @media (prefers-reduced-motion: reduce) { .os-lens { animation: none; } .os-cinema-link span { transition: none; } }
  @media (max-width: 800px) { .os-cinema-hero__grid { grid-template-columns: 1fr; padding-top: 5rem; } .os-cinema-hero__copy { order: 1; } .os-lens-stage { order: 0; min-height: 55vw; } .os-lens { width: min(62vw, 22rem); } .os-lens-stage__label--top { top: 5%; } .os-lens-stage__label--bottom { bottom: 3%; } .os-scroll-cue { display: none; } }
</style>

<style is:global>
  .os-proof-band--cinema .os-proof-band__grid { padding-block: 1.6rem; }
  .os-proof-band--cinema .os-proof-band__grid > div { border-color: rgb(248 245 237 / .16); }
</style>

<script>
  const lens = document.querySelector<HTMLElement>('.os-lens');
  const stage = document.querySelector<HTMLElement>('.os-lens-stage');
  if (lens && stage && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    stage.addEventListener('pointermove', (event: PointerEvent) => {
      const rect = stage.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - .5;
      const y = (event.clientY - rect.top) / rect.height - .5;
      lens.style.transform = `rotate(-14deg) translate(${x * 12}px, ${y * 12}px)`;
    });
    stage.addEventListener('pointerleave', () => { lens.style.transform = 'rotate(-14deg)'; });
  }
</script>
