---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import HomeOpening from '~/components/site/HomeOpening.astro';
import FinalCTA from '~/components/site/FinalCTA.astro';
import Button from '~/components/ui/Button.astro';
import { capabilityGroups, faqs } from '~/data/optic-site';
import FAQs from '~/components/widgets/FAQs.astro';

const metadata = {
  title: 'OptiSolution — From vision to clarity',
  ignoreTitleTemplate: true,
  description: 'OptiSolution connects eye care, eyewear, retail operations, and management in one precise platform.',
};
const chapters = [
  ['01', 'The story of vision', 'Vision is never just a measurement. It is the confidence to move through the world. OptiSolution gives optical teams the clarity to care for that journey.'],
  ['02', 'Examination & precision', 'Every clear result begins with precise measurement. Keep client context, corrections, and decisions close to the work.'],
  ['03', 'Lens intelligence', 'Data becomes precision. Precision becomes the right lens, the right treatment, and a better experience for every client.'],
];
---
<MarketingLayout metadata={metadata}>
  <HomeOpening />
  <main id="story">
    <section class="os-story-section os-story-section--light">
      <div class="os-container os-story-intro"><div><p class="os-eyebrow">A human starting point</p><h2>Clarity is personal.</h2></div><p>Behind every prescription is a person looking for confidence. Behind every pair of glasses is a team doing precise, meaningful work. We build the space between the two.</p></div>
      <div class="os-container os-chapter-grid">{chapters.map(([number, title, text]) => <article><span>{number}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
    </section>
    <section class="os-story-section os-story-section--green"><div class="os-container os-precision-grid"><div><p class="os-eyebrow">Examination & precision</p><h2>Every clear result begins with precise measurement.</h2><p class="os-lead">Bring the examination into the same connected journey as the product and the business. Fewer gaps. More confidence at every handoff.</p><Button variant="secondary" href="/fonctionnalites" text="Explore the workflow" icon="tabler:arrow-up-right" /></div><div class="os-device-card"><div class="os-device-card__ring"></div><div class="os-device-card__readout"><span>OPTICAL READOUT</span><strong>OD&nbsp; +1.25</strong><strong>OG&nbsp; +1.00</strong><small>ready for review</small></div></div></div></section>
    <section class="os-story-section os-story-section--cream"><div class="os-container"><div class="os-section-intro"><p class="os-eyebrow">One connected system</p><h2>From prescription to finished eyewear.</h2><p>OptiSolution keeps the full optical journey in focus: the people, products, orders, stock, and decisions that make a store move.</p></div><div class="os-capability-row">{capabilityGroups.slice(0, 3).map((group, index) => <article><div class="os-capability-row__image"><img src={group.image} alt={group.imageAlt} loading="lazy" /></div><div class="os-capability-row__body"><span>0{index + 1}</span><h3>{group.title}</h3><p>{group.description}</p></div></article>)}</div></div></section>
    <section class="os-story-section os-story-section--dark"><div class="os-container"><div class="os-section-intro"><p class="os-eyebrow">The platform layer</p><h2>One connected system for the entire optical journey.</h2><p>Clear tools for client management, examination records, prescriptions, orders, inventory, analytics, and store management.</p></div><div class="os-module-grid">{['Client records', 'Examinations', 'Prescriptions', 'Orders & inventory', 'Store operations', 'Analytics'].map((item, index) => <div><span>0{index + 1}</span><strong>{item}</strong><i aria-hidden="true">↗</i></div>)}</div><a class="os-text-link os-text-link--light" href="/fonctionnement">See how it works <span aria-hidden="true">→</span></a></div></section>
    <section class="os-story-section os-impact-section"><div class="os-container os-impact-grid"><div><p class="os-eyebrow">Built for real optical businesses</p><h2>Confidence in every interaction.</h2></div><div class="os-impact-points"><p>01 <strong>Operational clarity</strong><span>Give every role the right context, without asking them to rebuild the story.</span></p><p>02 <strong>A calmer workflow</strong><span>Reduce repetition and make the next useful step easier to see.</span></p><p>03 <strong>Control that grows</strong><span>Build the system around your store, your data, and your way of serving clients.</span></p></div></div></section>
    <FAQs id="questions" title="Questions before a demonstration" subtitle="A few practical answers about scope, setup, training, and data." items={faqs.slice(0, 4)} collapsible defaultOpen={0} schema classes={{ container: 'os-faq-shell', headline: { container: 'os-faq-heading' }, list: 'os-faq-list' }} />
  </main>
  <FinalCTA />
</MarketingLayout>

<style>
  .os-story-section { padding-block: clamp(5rem, 10vw, 9rem); } .os-story-section--light { background: #f7f4ec; } .os-story-section--cream { background: #eeebe2; } .os-story-section--green { color: var(--os-cream-50); background: var(--os-forest-900); } .os-story-section--green h2, .os-story-section--dark h2 { color: var(--os-cream-50); }
  .os-story-intro, .os-precision-grid, .os-impact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(3rem, 10vw, 10rem); align-items: end; } .os-story-intro { padding-bottom: 6rem; } .os-story-intro h2, .os-story-section h2 { max-width: 43rem; margin: 0; color: var(--os-ink-900); font: 500 clamp(3rem, 6vw, 6rem)/.92 Georgia, serif; letter-spacing: -.065em; } .os-story-intro > p { max-width: 31rem; color: var(--os-ink-600); font-size: 1.15rem; line-height: 1.8; }
  .os-chapter-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border-top: 1px solid rgb(15 61 50 / .18); } .os-chapter-grid article { display: grid; gap: 3rem; padding: 1.5rem 1.5rem 0 0; border-right: 1px solid rgb(15 61 50 / .18); } .os-chapter-grid article:not(:first-child) { padding-left: 1.5rem; } .os-chapter-grid span, .os-impact-points p { color: var(--os-gold-700); font-size: .72rem; letter-spacing: .14em; } .os-chapter-grid h3 { margin: 0 0 1rem; color: var(--os-ink-900); font: 500 1.8rem/1.05 Georgia, serif; } .os-chapter-grid p { margin: 0; color: var(--os-ink-600); line-height: 1.7; }
  .os-precision-grid { align-items: center; } .os-story-section--green .os-lead { color: rgb(248 245 237 / .7); } .os-story-section--green .os-eyebrow { color: var(--os-gold-400); } .os-device-card { position: relative; min-height: 30rem; display: grid; place-items: center; overflow: hidden; border: 1px solid rgb(248 245 237 / .17); background: radial-gradient(circle at 50% 45%, rgb(109 155 141 / .35), transparent 25%), #123d33; } .os-device-card__ring { width: 70%; aspect-ratio: 1; border: 1px solid rgb(218 238 225 / .6); border-radius: 50%; box-shadow: 0 0 0 35px rgb(218 238 225 / .05), 0 0 0 90px rgb(218 238 225 / .04); } .os-device-card__readout { position: absolute; right: 12%; bottom: 12%; display: grid; gap: .45rem; padding: 1rem; border: 1px solid rgb(248 245 237 / .24); color: var(--os-cream-50); background: rgb(15 61 50 / .72); backdrop-filter: blur(12px); } .os-device-card__readout span, .os-device-card__readout small { color: var(--os-gold-400); font-size: .6rem; letter-spacing: .15em; text-transform: uppercase; } .os-device-card__readout strong { font: 500 1.4rem Georgia, serif; }
  .os-capability-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; } .os-capability-row article { background: #f7f4ec; } .os-capability-row__image { aspect-ratio: 1.35; overflow: hidden; } .os-capability-row img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; } .os-capability-row article:hover img { transform: scale(1.04); } .os-capability-row__body { padding: 1.5rem; } .os-capability-row__body span { color: var(--os-gold-700); font-size: .7rem; } .os-capability-row h3 { margin: .8rem 0 .5rem; color: var(--os-ink-900); font: 500 1.6rem Georgia, serif; } .os-capability-row p { margin: 0; color: var(--os-ink-600); line-height: 1.6; }
  .os-story-section--dark { color: var(--os-cream-50); background: var(--os-ink-900); } .os-story-section--dark .os-section-intro > p:last-child { color: rgb(248 245 237 / .65); } .os-story-section--dark .os-eyebrow { color: var(--os-gold-400); } .os-module-grid { display: grid; grid-template-columns: repeat(3, 1fr); margin-block: 3rem 2rem; border-top: 1px solid rgb(248 245 237 / .18); } .os-module-grid div { display: flex; align-items: center; gap: 1rem; min-height: 5.5rem; border-bottom: 1px solid rgb(248 245 237 / .18); } .os-module-grid span { color: var(--os-gold-400); font-size: .7rem; } .os-module-grid strong { font: 500 1.25rem Georgia, serif; } .os-module-grid i { margin-left: auto; color: var(--os-gold-400); font-style: normal; } .os-text-link--light { color: var(--os-cream-50); }
  .os-impact-section { background: #dfe9e1; } .os-impact-grid { align-items: start; } .os-impact-points { display: grid; gap: 1.5rem; } .os-impact-points p { display: grid; grid-template-columns: 2rem 1fr; gap: .5rem; margin: 0; padding-top: 1rem; border-top: 1px solid rgb(15 61 50 / .2); } .os-impact-points strong { color: var(--os-ink-900); font: 500 1.25rem Georgia, serif; } .os-impact-points span { grid-column: 2; color: var(--os-ink-600); font-size: .95rem; letter-spacing: 0; line-height: 1.5; }
  @media (max-width: 800px) { .os-story-intro, .os-precision-grid, .os-impact-grid, .os-chapter-grid, .os-capability-row { grid-template-columns: 1fr; } .os-story-intro { gap: 1.5rem; padding-bottom: 3.5rem; } .os-chapter-grid article, .os-chapter-grid article:not(:first-child) { gap: 1rem; padding: 1.5rem 0; border-right: 0; border-bottom: 1px solid rgb(15 61 50 / .18); } .os-device-card { min-height: 22rem; } .os-module-grid { grid-template-columns: 1fr 1fr; } .os-module-grid div { padding-right: .75rem; } }
</style>
