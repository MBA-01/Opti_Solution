---
import Button from '~/components/ui/Button.astro';
import OpticalStill from '~/components/brand/OpticalStill.astro';

interface Props {
  title: string;
  text: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  chapter?: string;
  compact?: boolean;
}

const {
  title,
  text,
  primaryText = 'Réserver un échange',
  primaryHref = 'https://calendly.com/opvibe01/30min',
  secondaryText,
  secondaryHref,
  chapter,
  compact = false,
} = Astro.props;
---

<section class:list={['os-page-hero', { 'os-page-hero--compact': compact }]}>
  <div class="os-container os-page-hero__grid">
    <div class="os-page-hero__copy">
      {chapter && <span class="os-chapter">{chapter}</span>}
      <h1>{title}</h1>
      <p class="os-lead">{text}</p>
      <div class="os-actions">
        <Button
          variant="primary"
          href={primaryHref}
          text={primaryText}
          target={primaryHref.startsWith('http') ? '_blank' : undefined}
          data-cta={primaryHref.includes('calendly.com') ? 'calendly-page-hero' : undefined}
          icon="tabler:arrow-right"
        />
        {secondaryText && secondaryHref && <Button variant="secondary" href={secondaryHref} text={secondaryText} />}
      </div>
    </div>
    <div class="os-page-hero__visual">
      <slot name="visual">
        <OpticalStill variant="story" />
      </slot>
    </div>
  </div>
</section>
