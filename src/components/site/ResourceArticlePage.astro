---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import FinalCTA from '~/components/site/FinalCTA.astro';
import ScreenshotFrame from '~/components/ui/ScreenshotFrame.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import type { ResourceArticle } from '~/data/resource-articles';
import { resourceArticles } from '~/data/resource-articles';
import { getCanonical } from '~/utils/permalinks';

interface Props {
  article: ResourceArticle;
}

const { article } = Astro.props;
const relatedCandidates = resourceArticles.filter((item) => item.slug !== article.slug);
const related = (
  article.relatedSlugs?.length
    ? article.relatedSlugs
        .map((slug) => resourceArticles.find((item) => item.slug === slug))
        .filter((item): item is ResourceArticle => Boolean(item))
    : [
        ...relatedCandidates.filter((item) => item.category === article.category),
        ...relatedCandidates.filter((item) => item.category !== article.category),
      ]
).slice(0, 3);
const articleText = [
  article.title,
  article.intro || article.description,
  ...article.sections.flatMap((section) => [
    section.title,
    ...(section.paragraphs || []),
    ...(section.list || []),
    ...(section.table?.headers || []),
    ...(section.table?.rows.flat() || []),
    section.note?.title || '',
    section.note?.text || '',
  ]),
  article.capability.title,
  article.capability.text,
].join(' ');
const readingMinutes = Math.max(
  1,
  Math.ceil((articleText.match(/[\p{L}\p{N}][\p{L}\p{N}'’.-]*/gu)?.length || 0) / 200)
);
const formatDate = (isoDate: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(`${isoDate}T12:00:00Z`)
  );
const metadata = {
  title: article.seoTitle || article.title,
  description: article.description,
  openGraph: {
    type: 'article',
    article: {
      publishedTime: article.published,
      modifiedTime: article.modified,
      authors: [String(getCanonical('/a-propos'))],
      section: article.category,
    },
  },
};
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.published,
  dateModified: article.modified,
  inLanguage: 'fr',
  mainEntityOfPage: String(getCanonical(`/ressources/${article.slug}`)),
  image: String(new URL(article.image, Astro.site)),
  author: {
    '@type': 'Person',
    name: article.author,
    url: String(getCanonical('/a-propos')),
  },
  publisher: {
    '@id': `${String(getCanonical('/'))}#organization`,
  },
};
---

<MarketingLayout metadata={metadata}>
  <StructuredData slot="head" schema={articleSchema} />
  <article class="os-article-shell">
    <header class="os-article">
      <div class="os-article__meta">
        <span>{article.type} · {article.category}</span><span>{readingMinutes} min de lecture</span><span>
          Publié le <time datetime={article.published}>{formatDate(article.published)}</time>
        </span><span>Mis à jour le <time datetime={article.modified}>{formatDate(article.modified)}</time></span>
      </div>
      <h1>{article.title}</h1>
      <p class="os-article__intro">{article.intro || article.description}</p>
      <div class="mt-10">
        <ScreenshotFrame
          src={article.image}
          alt={article.imageAlt}
          label={article.imageLabel}
          caption={article.imageCaption}
          href={article.image}
          aspect="tablet"
        />
      </div>
    </header>

    <div class="os-article os-prose">
      {
        article.sections.map((section, index) => (
          <section>
            <h2>{`${index + 1}. ${section.title}`}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.list && (
              <ul>
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {section.table && (
              <div class="os-table-wrap" tabindex="0" role="region" aria-label={`Tableau : ${section.title}`}>
                <table>
                  <thead>
                    <tr>
                      {section.table.headers.map((header) => (
                        <th scope="col">{header}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, cellIndex) =>
                          cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.note && (
              <div class="os-callout">
                <strong>{section.note.title}</strong>
                <p>{section.note.text}</p>
              </div>
            )}
          </section>
        ))
      }

      <div class="os-callout">
        <strong>{article.capability.title}</strong>
        <p>{article.capability.text}</p>
        <a class="os-text-link" href={article.capability.href}>{article.capability.linkText} →</a>
      </div>

      <aside class="os-author-card" aria-label="À propos de l’auteur">
        <div class="os-author-card__monogram" aria-hidden="true">ME</div>
        <div>
          <p class="os-kicker">À propos de l’auteur</p>
          <h2>{article.author}</h2>
          <p>
            Fondateur d’Opti Solution, Mohamed travaille sur la conception, la configuration et le développement de
            parcours Odoo adaptés aux opérations des magasins d’optique.
          </p>
          <a class="os-text-link" href="/a-propos">Découvrir l’approche d’Opti Solution →</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="os-section os-section--soft" aria-labelledby="related-title">
    <div class="os-container">
      <p class="os-eyebrow">À lire ensuite</p>
      <h2 id="related-title" class="text-[clamp(2rem,4vw,3.5rem)] leading-none font-serif tracking-[-0.04em]">
        Poursuivez avec une autre question opérationnelle.
      </h2>
      <div class="os-resource-grid mt-10">
        {
          related.map((item) => (
            <a class="os-resource-card" href={`/ressources/${item.slug}`}>
              <div class="os-resource-card__meta">
                <span>
                  {item.type} · {item.category}
                </span>
                <span>Article</span>
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <strong>Lire la ressource →</strong>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <FinalCTA
    title="Voyez comment ce sujet s’applique à votre magasin."
    text="Choisissez le parcours à approfondir et préparez une démonstration guidée autour de votre organisation."
  />
</MarketingLayout>
