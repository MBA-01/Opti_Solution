<dialog class="os-lightbox" data-product-lightbox aria-labelledby="product-lightbox-caption">
  <div class="os-lightbox__panel">
    <button class="os-lightbox__close" type="button" data-product-lightbox-close aria-label="Fermer l’aperçu">
      <span>Fermer</span>
      <span aria-hidden="true">×</span>
    </button>
    <figure>
      <img data-product-lightbox-image src="" alt="" />
      <figcaption id="product-lightbox-caption" data-product-lightbox-caption></figcaption>
    </figure>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-product-lightbox]');

  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-product-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-product-lightbox-caption]');
    const closeButton = dialog.querySelector<HTMLButtonElement>('[data-product-lightbox-close]');
    let activeTrigger: HTMLElement | null = null;

    const closePreview = () => dialog.close();

    document.querySelectorAll<HTMLElement>('[data-product-preview]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.dataset.src;
        if (!src || !image || !caption) return;

        activeTrigger = trigger;
        image.src = src;
        image.alt = trigger.dataset.alt ?? '';
        caption.textContent = trigger.dataset.caption ?? trigger.dataset.alt ?? '';
        document.documentElement.classList.add('os-lightbox-open');
        dialog.showModal();
      });
    });

    closeButton?.addEventListener('click', closePreview);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closePreview();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('os-lightbox-open');
      image?.removeAttribute('src');
      activeTrigger?.focus();
      activeTrigger = null;
    });
  }
</script>

<style>
  :global(.os-lightbox-open) {
    overflow: hidden;
  }

  :global([data-product-preview]) {
    cursor: zoom-in;
  }

  :global([data-product-preview]:focus-visible) {
    outline: 3px solid var(--os-gold-400);
    outline-offset: 3px;
  }

  .os-lightbox {
    width: min(94vw, 92rem);
    max-width: none;
    max-height: 94vh;
    margin: auto;
    overflow: visible;
    border: 0;
    padding: 0;
    background: transparent;
  }

  .os-lightbox::backdrop {
    background: rgb(4 17 14 / 0.86);
    backdrop-filter: blur(0.35rem);
  }

  .os-lightbox__panel {
    position: relative;
    border-radius: var(--os-radius-md);
    padding: 0.65rem;
    outline: 1px solid oklch(1 0 0 / 0.14);
    outline-offset: -1px;
    background: #111b18;
    box-shadow: 0 2rem 7rem rgb(0 0 0 / 0.48);
  }

  .os-lightbox figure {
    margin: 0;
  }

  .os-lightbox img {
    display: block;
    width: 100%;
    max-height: calc(94vh - 5.5rem);
    border-radius: calc(var(--os-radius-md) - 0.3rem);
    outline: 1px solid oklch(1 0 0 / 0.1);
    outline-offset: -1px;
    background: var(--os-cream-50);
    object-fit: contain;
  }

  .os-lightbox figcaption {
    min-height: 2.8rem;
    padding: 0.85rem 0.35rem 0.15rem;
    color: rgb(248 245 237 / 0.72);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .os-lightbox__close {
    position: absolute;
    z-index: 2;
    top: 1.1rem;
    right: 1.1rem;
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    min-height: 2.6rem;
    border: 0;
    border-radius: 999px;
    padding: 0.55rem 0.8rem 0.55rem 0.95rem;
    color: var(--os-forest-900);
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--os-shadow-sm);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 750;
    transition:
      background-color 120ms var(--os-ease),
      transform 120ms var(--os-ease);
  }

  .os-lightbox__close:hover {
    background: white;
  }

  .os-lightbox__close:active {
    transform: scale(0.96);
  }

  .os-lightbox__close span:last-child {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }

  @media (max-width: 639px) {
    .os-lightbox {
      width: calc(100vw - 1rem);
    }

    .os-lightbox__panel {
      padding: 0.35rem;
    }

    .os-lightbox img {
      max-height: calc(94vh - 4.8rem);
    }

    .os-lightbox__close span:first-child {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .os-lightbox__close {
      transition: none;
    }
  }
</style>
