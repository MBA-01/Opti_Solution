---
interface Props {
  src: string;
  alt?: string;
  label?: string;
  caption: string;
  href?: string;
  eager?: boolean;
  aspect?: 'landscape' | 'tablet' | 'phone';
  class?: string;
}

const { src, alt = '', label, caption, href, eager = false, aspect = 'landscape', class: className = '' } = Astro.props;
const previewSource = href ?? src;
const dimensions =
  aspect === 'tablet'
    ? { width: 1024, height: 1366 }
    : aspect === 'phone'
      ? { width: 430, height: 932 }
      : { width: 1920, height: 1080 };
---

<figure class:list={['os-screen', `os-screen--${aspect}`, className]}>
  <div class="os-screen__bar" aria-hidden="true"><i></i><i></i><i></i>{label && <span>{label}</span>}</div>
  <button
    class="os-screen__viewport"
    type="button"
    data-product-preview
    data-src={previewSource}
    data-alt={alt}
    data-caption={caption}
    aria-label={`Agrandir l’image : ${caption}`}
  >
    <img
      src={src}
      alt={alt}
      width={dimensions.width}
      height={dimensions.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </button>
  <figcaption>
    <span>{caption}</span>
    {
      href && (
        <button type="button" data-product-preview data-src={previewSource} data-alt={alt} data-caption={caption}>
          Agrandir <span aria-hidden="true">↗</span>
        </button>
      )
    }
  </figcaption>
</figure>

<style>
  .os-screen {
    overflow: hidden;
    border-radius: var(--os-radius-md);
    outline: var(--os-edge-raised);
    outline-offset: -1px;
    background: var(--os-surface);
    box-shadow: var(--os-shadow-md);
    transition-property: box-shadow, transform;
    transition-duration: var(--os-motion-standard-enter);
    transition-timing-function: var(--os-ease-enter);
  }
  .os-screen__bar {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    gap: 0.32rem;
    padding: 0 0.8rem;
    border-bottom: 1px solid var(--os-line);
    color: var(--os-ink-600);
    font-size: 0.72rem;
  }
  .os-screen__bar i {
    display: block;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--os-line);
  }
  .os-screen__bar span {
    margin-left: auto;
    font-weight: 650;
  }
  .os-screen__viewport {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 0;
    padding: 0;
    background: var(--os-forest-100);
    text-align: left;
  }
  .os-screen--tablet .os-screen__viewport {
    aspect-ratio: 4 / 3;
  }
  .os-screen--phone .os-screen__viewport {
    aspect-ratio: 9 / 16;
  }
  .os-screen__viewport img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform var(--os-motion-standard-enter) var(--os-ease-enter);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.9rem;
    color: var(--os-ink-600);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  figcaption button {
    flex: none;
    border: 0;
    padding: 0;
    color: var(--os-forest-800);
    background: transparent;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.16rem;
    transition-property: color, text-decoration-color;
    transition-duration: var(--os-motion-subtle-enter);
    transition-timing-function: var(--os-ease);
  }
  figcaption button:focus-visible {
    border-radius: 0.25rem;
    outline: 3px solid var(--os-forest-700);
    outline-offset: 3px;
  }
  .os-screen:hover .os-screen__viewport img {
    transform: translateY(-2px) scale(1.006);
  }
  .os-screen:hover {
    box-shadow: var(--os-shadow-hover);
  }
  @media (prefers-reduced-motion: reduce) {
    .os-screen,
    .os-screen__viewport img {
      transition: none;
    }

    .os-screen:hover .os-screen__viewport img {
      transform: none;
    }
  }
</style>
