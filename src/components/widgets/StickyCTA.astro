---
import Button from '~/components/ui/Button.astro';
import type { StickyCTA as Props } from '~/types';

// A bar fixed to the bottom of the viewport that slides in once the
// visitor has scrolled past `showAfter` pixels. Mobile-only by default,
// where the hero button is long gone by the time the reader decides.

const {
  text,
  href,
  label,
  target,
  icon = 'tabler:arrow-right',
  showAfter = 600,
  mobileOnly = true,
  hideWhen = '',
  id,
} = Astro.props;
---

<aw-sticky-cta
  id={id}
  data-show-after={showAfter}
  data-hide-when={hideWhen}
  class:list={[
    'fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 motion-reduce:transition-none',
    mobileOnly ? 'md:hidden' : '',
  ]}
  hidden
>
  <div
    class="os-sticky-cta__bar mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 pt-3"
    style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
  >
    {label && <p class="os-sticky-cta__label text-sm font-medium">{label}</p>}
    <Button
      variant="primary"
      text={text}
      href={href}
      target={target}
      icon={icon}
      class="shrink-0 !py-2.5 !px-5"
      data-analytics-event="cta_click"
      data-analytics-label="sticky_mobile_demo"
    />
  </div>
</aw-sticky-cta>

<script>
  class AwStickyCta extends HTMLElement {
    private threshold = 600;
    private ticking = false;
    private blocked = false;
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.threshold = Number(this.dataset.showAfter ?? 600);
      this.hidden = false;
      window.addEventListener('scroll', this.queueUpdate, { passive: true });

      const selectors = this.dataset.hideWhen;
      if (selectors && 'IntersectionObserver' in window) {
        const targets = Array.from(document.querySelectorAll(selectors));
        const visibleTargets = new Set<Element>();
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visibleTargets.add(entry.target);
            else visibleTargets.delete(entry.target);
          });
          this.blocked = visibleTargets.size > 0;
          this.queueUpdate();
        });
        targets.forEach((target) => this.observer?.observe(target));
      }

      this.update();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.queueUpdate);
      this.observer?.disconnect();
    }

    private queueUpdate = () => {
      if (this.ticking) return;
      this.ticking = true;
      window.requestAnimationFrame(this.update);
    };

    private update = () => {
      this.classList.toggle('translate-y-full', window.scrollY < this.threshold || this.blocked);
      this.ticking = false;
    };
  }
  if (!customElements.get('aw-sticky-cta')) customElements.define('aw-sticky-cta', AwStickyCta);
</script>
