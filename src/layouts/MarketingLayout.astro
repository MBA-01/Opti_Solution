---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import ProductLightbox from '~/components/ui/ProductLightbox.astro';
import ScrollMotion from '~/components/common/ScrollMotion.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import AnalyticsConsent from '~/components/common/AnalyticsConsent.astro';
import StickyCTA from '~/components/widgets/StickyCTA.astro';
import { primaryNav, footerLinks } from '~/data/optic-site';
import { getCanonical } from '~/utils/permalinks';
import shareImage from '~/assets/images/opti-solution-share.png';
import '~/assets/styles/optic-site.css';
import type { MetaData } from '~/types';

interface Props {
  metadata?: MetaData;
}

const { metadata = {} } = Astro.props;
const pathname = Astro.url.pathname;
const pageName = pathname === '/' ? 'home' : pathname.replace(/^\/+|\/+$/g, '').replaceAll('/', '-');
const pageTitle = typeof metadata.title === 'string' ? metadata.title.replace(/\s+—\s+Opti Solution$/, '') : '';

const routeLabels: Record<string, string> = {
  solution: 'Solution',
  fonctionnement: 'Fonctionnement',
  fonctionnalites: 'Fonctionnalités',
  demo: 'Démonstration',
  calculateur: 'Calculateur',
  'mise-en-place': 'Mise en place',
  ressources: 'Ressources',
  services: 'Services',
  'a-propos': 'À propos',
  contact: 'Contact',
  'conditions-generales': 'Conditions générales',
  'politique-retours': 'Politique de retours',
  garantie: 'Garantie & support',
  confidentialite: 'Confidentialité',
  merci: 'Demande envoyée',
};
const segments = pathname.split('/').filter(Boolean);
const showBreadcrumbs =
  pathname !== '/' &&
  !pathname.startsWith('/concepts/') &&
  !pathname.startsWith('/homes/') &&
  !pageTitle.startsWith('Page introuvable');
const breadcrumbItems: Array<{ text: string; href?: string; icon?: string }> = [
  { text: 'Accueil', href: '/', icon: 'tabler:home' },
];
let breadcrumbHref = '';
segments.forEach((segment, index) => {
  breadcrumbHref += `/${segment}`;
  const isCurrent = index === segments.length - 1;
  breadcrumbItems.push({
    text: isCurrent && pageTitle ? pageTitle : routeLabels[segment] || segment.replaceAll('-', ' '),
    ...(isCurrent ? {} : { href: breadcrumbHref }),
  });
});

const businessStreet = import.meta.env.PUBLIC_BUSINESS_STREET?.trim();
const businessCity = import.meta.env.PUBLIC_BUSINESS_CITY?.trim();
const businessPostalCode = import.meta.env.PUBLIC_BUSINESS_POSTAL_CODE?.trim();
const businessCountry = import.meta.env.PUBLIC_BUSINESS_COUNTRY?.trim() || 'MA';
const hasLocalAddress = Boolean(businessStreet && businessCity && businessPostalCode);
const canonicalHome = String(getCanonical('/'));
const socialImage = String(new URL(shareImage.src, Astro.site));
const organizationLogo = String(new URL('/brand/opti-solution-icon.png', Astro.site));
const verifiedSocialProfiles = {
  linkedin: import.meta.env.PUBLIC_LINKEDIN_URL?.trim() || 'https://www.linkedin.com/company/opti-solution-ma',
  facebook: import.meta.env.PUBLIC_FACEBOOK_URL?.trim() || 'https://web.facebook.com/profile.php?id=61594629787401',
  instagram: import.meta.env.PUBLIC_INSTAGRAM_URL?.trim() || 'https://www.instagram.com/solution.opti/',
  x: import.meta.env.PUBLIC_X_URL?.trim() || 'https://x.com/OptiSolution01',
  threads: import.meta.env.PUBLIC_THREADS_URL?.trim() || 'https://www.threads.com/@solution.opti?hl=en',
};
const organizationSocialProfiles = Object.values(verifiedSocialProfiles);
const businessSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': hasLocalAddress ? 'ProfessionalService' : 'Organization',
      '@id': `${canonicalHome}#organization`,
      name: 'Opti Solution',
      url: canonicalHome,
      description: 'Logiciel de gestion et services Odoo pour magasins d\u2019optique au Maroc.',
      logo: {
        '@type': 'ImageObject',
        url: organizationLogo,
        contentUrl: organizationLogo,
        width: 512,
        height: 512,
      },
      image: socialImage,
      email: 'hello@opvibe.com',
      telephone: '+212620169713',
      areaServed: { '@type': 'Country', name: 'Maroc' },
      ...(organizationSocialProfiles.length ? { sameAs: organizationSocialProfiles } : {}),
      ...(hasLocalAddress
        ? {
            address: {
              '@type': 'PostalAddress',
              streetAddress: businessStreet,
              addressLocality: businessCity,
              postalCode: businessPostalCode,
              addressCountry: businessCountry,
            },
          }
        : {}),
    },
    {
      '@type': 'WebSite',
      '@id': `${canonicalHome}#website`,
      url: canonicalHome,
      name: 'Opti Solution',
      inLanguage: 'fr-MA',
      publisher: { '@id': `${canonicalHome}#organization` },
    },
  ],
};
const showStickyCta =
  ![
    '/demo',
    '/merci',
    '/contact',
    '/confidentialite',
    '/conditions-generales',
    '/politique-retours',
    '/garantie',
  ].includes(pathname) &&
  !pathname.startsWith('/concepts/') &&
  !pageTitle.startsWith('Page introuvable');
const socialLinks = [
  {
    ariaLabel: 'Opti Solution sur LinkedIn',
    icon: 'tabler:brand-linkedin',
    href: verifiedSocialProfiles.linkedin,
  },
  {
    ariaLabel: 'Opti Solution sur Facebook',
    icon: 'tabler:brand-facebook',
    href: verifiedSocialProfiles.facebook,
  },
  {
    ariaLabel: 'Opti Solution sur Instagram',
    icon: 'tabler:brand-instagram',
    href: verifiedSocialProfiles.instagram,
  },
  {
    ariaLabel: 'Opti Solution sur X',
    icon: 'tabler:brand-x',
    href: verifiedSocialProfiles.x,
  },
];
const copyrightYear = new Date().getFullYear();
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {pathname === '/' && <StructuredData slot="head" schema={businessSchema} />}
  <a class="os-skip" href="#main">Aller au contenu</a>
  <Header
    links={primaryNav}
    actions={[{ variant: 'primary', text: 'Demander une démo', href: '/demo#demande', icon: 'tabler:arrow-right' }]}
    mobileAction={{ variant: 'primary', text: 'Démo', href: '/demo#demande' }}
    isSticky
  />
  <main id="main" class="os-main" data-page={pageName}>
    {showBreadcrumbs && <Breadcrumbs items={breadcrumbItems} bar />}
    <slot />
  </main>
  <ProductLightbox />
  <ScrollMotion />
  {
    showStickyCta && (
      <StickyCTA
        text="Demander une démo"
        href="/demo#demande"
        label="Échange autour de vos priorités"
        showAfter={520}
        hideWhen="#demande, footer"
      />
    )
  }
  <Footer
    links={footerLinks}
    secondaryLinks={[
      { text: 'Contact', href: '/contact' },
      { text: 'Confidentialité', href: '/confidentialite' },
    ]}
    socialLinks={socialLinks}
    footNote={`© ${copyrightYear} Opti Solution · Tous droits réservés.`}
    theme="dark"
  />
  <AnalyticsConsent />
</Layout>
