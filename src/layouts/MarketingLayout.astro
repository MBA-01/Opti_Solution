---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import ProductLightbox from '~/components/ui/ProductLightbox.astro';
import { primaryNav, footerLinks } from '~/data/optic-site';
import { CALENDLY_URL } from '~/data/contact';
import '~/assets/styles/optic-site.css';
import type { MetaData } from '~/types';

interface Props {
  metadata?: MetaData;
}

const { metadata = {} } = Astro.props;
const pageName =
  Astro.url.pathname === '/' ? 'home' : Astro.url.pathname.replace(/^\/+|\/+$/g, '').replaceAll('/', '-');
---

<Layout metadata={metadata}>
  <a class="os-skip" href="#main">Aller au contenu</a>
  <Header
    links={primaryNav}
    actions={[
      {
        variant: 'primary',
        text: 'Planifier une démo',
        href: CALENDLY_URL,
        icon: 'tabler:arrow-right',
        target: '_blank',
      },
    ]}
    mobileAction={{ variant: 'primary', text: 'Démo', href: CALENDLY_URL, target: '_blank' }}
    isSticky
  />
  <main id="main" class="os-main" data-page={pageName}><slot /></main>
  <ProductLightbox />
  <Footer
    links={footerLinks}
    secondaryLinks={[{ text: 'Confidentialité', href: '/confidentialite' }]}
    socialLinks={[]}
    footNote="OptiSolution · La gestion reliée au métier de l’optique."
    theme="dark"
  />
</Layout>

<script>
  const initCtaEvents = () => {
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((link) => {
      if (link.dataset.ctaReady === 'true') return;
      link.dataset.ctaReady = 'true';
      link.addEventListener('click', () => {
        document.dispatchEvent(
          new CustomEvent('optisolution:cta', {
            detail: { name: link.dataset.cta, path: window.location.pathname },
          })
        );
      });
    });
  };

  document.addEventListener('astro:page-load', initCtaEvents);
  initCtaEvents();
</script>
