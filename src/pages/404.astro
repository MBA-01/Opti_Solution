---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import Button from '~/components/ui/Button.astro';
---

<MarketingLayout
  metadata={{
    title: 'Page introuvable',
    description: 'Cette adresse ne correspond à aucune page du site Opti Solution.',
    robots: { index: false, follow: true },
  }}
>
  <section class="os-page-hero os-page-hero--compact">
    <div class="os-container os-page-hero__grid">
      <div class="os-page-hero__copy">
        <span class="os-chapter">Erreur 404</span>
        <p class="os-eyebrow">Page introuvable</p>
        <h1>Cette adresse ne mène plus à la page recherchée.</h1>
        <p class="os-lead">
          Revenez à l’accueil ou explorez le fonctionnement d’Opti Solution pour retrouver le contenu recherché.
        </p>
        <div class="os-actions">
          <Button variant="primary" href="/" text="Retour à l’accueil" icon="tabler:arrow-right" />
          <Button variant="secondary" href="/fonctionnement" text="Découvrir le fonctionnement" />
        </div>
        <nav class="os-404-links" aria-label="Pages utiles">
          <span>Pages utiles</span>
          <a href="/solution">La solution</a>
          <a href="/fonctionnalites">Les fonctionnalités</a>
          <a href="/demo">La démonstration</a>
        </nav>
      </div>
      <div class="os-page-hero__visual" aria-hidden="true">
        <div class="os-calculator-teaser__panel">
          <p class="os-kicker">Reprendre le parcours</p>
          <div class="os-teaser-bars">
            <div><span>Client</span><i style="--bar: 100%"></i><b>01</b></div>
            <div><span>Correction</span><i style="--bar: 82%"></i><b>02</b></div>
            <div><span>Devis</span><i style="--bar: 64%"></i><b>03</b></div>
            <div><span>Règlement</span><i style="--bar: 46%"></i><b>06</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>
