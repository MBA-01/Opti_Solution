    /* Concept 02 — miniature living store */
    .shop-world {
      position: absolute;
      inset: 0;
      color: var(--ink);
      overflow: hidden;
    }
    .shop-world:before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 55% 48%, rgb(255 255 255 / 0.7), transparent 48%);
    }
    .shop-room {
      position: absolute;
      width: min(820px, 80%);
      height: 440px;
      left: 50%;
      top: 48%;
      transform: translate(-50%, -50%) rotateX(56deg) rotateZ(-32deg) scale(0.82);
      transform-style: preserve-3d;
      transition: 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .shop-floor {
      position: absolute;
      inset: 0;
      border: 1px solid rgb(15 61 50 / 0.2);
      background:
        repeating-linear-gradient(90deg, transparent 0 79px, rgb(15 61 50 / 0.055) 80px),
        repeating-linear-gradient(0deg, transparent 0 79px, rgb(15 61 50 / 0.055) 80px), #ece7da;
      box-shadow: 0 45px 70px rgb(30 56 50 / 0.2);
      transform: translateZ(0);
    }
    .shop-wall {
      position: absolute;
      background: linear-gradient(#fffdfa, #d9d4c8);
      border: 1px solid rgb(15 61 50 / 0.12);
    }
    .shop-wall--left {
      left: 0;
      top: 0;
      width: 20px;
      height: 100%;
      transform-origin: left;
      transform: rotateY(-90deg);
    }
    .shop-wall--back {
      left: 0;
      top: 0;
      width: 100%;
      height: 20px;
      transform-origin: top;
      transform: rotateX(90deg);
    }
    .shop-zone {
      position: absolute;
      width: 130px;
      height: 88px;
      padding: 12px;
      border: 1px solid rgb(15 61 50 / 0.16);
      border-radius: 10px;
      background: rgb(255 254 249 / 0.92);
      box-shadow: 12px 15px 25px rgb(34 54 49 / 0.15);
      transform: translateZ(35px);
      display: grid;
      grid-template-columns: 1fr auto;
      align-content: space-between;
      transition: 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .shop-zone:after {
      content: '';
      position: absolute;
      left: 6px;
      right: 6px;
      bottom: -17px;
      height: 16px;
      background: #c5c0b5;
      clip-path: polygon(0 0, 100% 0, 88% 100%, 12% 100%);
    }
    .shop-zone span {
      font: 8px ui-monospace;
      color: #998356;
    }
    .shop-zone b {
      grid-column: 1/-1;
      font-size: 10px;
    }
    .shop-zone .zone-icon {
      justify-self: end;
    }
    .zone-client {
      left: 60px;
      top: 290px;
    }
    .zone-exam {
      left: 240px;
      top: 290px;
    }
    .zone-frames {
      left: 330px;
      top: 160px;
    }
    .zone-stock {
      right: 70px;
      top: 70px;
    }
    .zone-pay {
      right: 40px;
      bottom: 55px;
    }
    .zone-icon,
    .orbit-node > i {
      position: relative;
      display: block;
      width: 30px;
      height: 24px;
      color: #0f3d32;
    }
    .person-icon:before {
      content: '';
      position: absolute;
      left: 10px;
      top: 0;
      width: 9px;
      height: 9px;
      border: 2px solid currentColor;
      border-radius: 50%;
    }
    .person-icon:after {
      content: '';
      position: absolute;
      left: 5px;
      top: 12px;
      width: 19px;
      height: 10px;
      border: 2px solid currentColor;
      border-radius: 14px 14px 3px 3px;
    }
    .lens-icon {
      border: 2px solid currentColor;
      border-radius: 50%;
    }
    .lens-icon:after {
      content: '';
      position: absolute;
      width: 8px;
      border-top: 2px solid currentColor;
      right: -7px;
      bottom: 1px;
      transform: rotate(45deg);
    }
    .frame-icon:before,
    .frame-icon:after {
      content: '';
      position: absolute;
      top: 5px;
      width: 12px;
      height: 10px;
      border: 2px solid currentColor;
      border-radius: 5px;
    }
    .frame-icon:before {
      left: 0;
    }
    .frame-icon:after {
      right: 0;
    }
    .frame-icon {
      border-top: 2px solid currentColor;
      margin-top: 8px;
    }
    .box-icon {
      border: 2px solid currentColor;
    }
    .box-icon:after {
      content: '';
      position: absolute;
      left: 5px;
      top: -2px;
      bottom: -2px;
      border-left: 2px solid currentColor;
    }
    .card-icon {
      border: 2px solid currentColor;
      border-radius: 3px;
    }
    .card-icon:after {
      content: '';
      position: absolute;
      left: 3px;
      right: 3px;
      top: 6px;
      border-top: 3px solid currentColor;
    }
    .doc-icon {
      border: 2px solid currentColor;
      border-radius: 2px;
    }
    .doc-icon:after {
      content: '';
      position: absolute;
      left: 4px;
      right: 4px;
      top: 7px;
      border-top: 2px solid currentColor;
      box-shadow: 0 5px 0 currentColor;
    }
    .shop-lines {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      transform: translateZ(50px);
      pointer-events: none;
    }
    .shop-lines path {
      fill: none;
      stroke: #afa99d;
      stroke-width: 3;
      stroke-dasharray: 12 14;
      stroke-linecap: round;
    }
    .shop-lines .line-lit {
      stroke: #c9a96b;
      stroke-width: 5;
      stroke-dasharray: 0;
      stroke-dashoffset: 0;
      opacity: 0;
      filter: drop-shadow(0 0 8px #d1b77f);
      transition: opacity 0.8s;
    }
    .shop-core {
      position: absolute;
      z-index: 4;
      left: 355px;
      top: 214px;
      width: 78px;
      height: 78px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #0f3d32;
      box-shadow: 0 18px 30px rgb(15 61 50 / 0.25);
      transform: translateZ(74px) rotateZ(32deg) rotateX(-56deg) scale(0.6);
      opacity: 0;
      transition: 0.8s;
    }
    .shop-core img {
      width: 45px;
      filter: brightness(0) invert(1);
    }
    .data-packet {
      position: absolute;
      z-index: 5;
