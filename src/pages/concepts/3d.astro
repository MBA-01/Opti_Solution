  <script>
    const setupConceptLab = () => {
      const root = document.querySelector<HTMLElement>('[data-concept-lab]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const concepts = [
        { id: 'clarte', number: '01', name: 'Clarté optique', cue: 'Le métier se remet au point.' },
        { id: 'magasin', number: '02', name: 'Magasin vivant', cue: 'Chaque zone rejoint le même flux.' },
        { id: 'monture', number: '03', name: 'Une monture, un parcours', cue: 'Le produit garde tout son contexte.' },
        {
          id: 'lentille',
          number: '04',
          name: 'La lentille-interface',
          cue: 'Déplacez la lentille pour révéler le système.',
        },
        { id: 'orbite', number: '05', name: 'Système orbital', cue: 'Six métiers. Un seul centre.' },
      ];
      const phaseLabels: Record<string, string[]> = {
        clarte: ['État fragmenté', 'Mise au point', 'Système relié'],
        magasin: ['Zones isolées', 'Le cœur apparaît', 'Flux continu'],
        monture: ['Produit seul', 'Contexte rattaché', 'Fiche complète'],
        lentille: ['Vision dispersée', 'Zone de clarté', 'Interface révélée'],
        orbite: ['Modules séparés', 'Connexions actives', 'Un seul système'],
      };
      let active = root.dataset.active || 'clarte';
      let phase = Number(root.dataset.phase || 0);
      let playing = true;
      let timer = 0;
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-concept]')];
      const scenes = [...root.querySelectorAll<HTMLElement>('[data-scene]')];
      const phaseButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-phase-button]')];
      const playButton = root.querySelector<HTMLButtonElement>('[data-play]');
      const name = root.querySelector<HTMLElement>('[data-current-name]');
      const number = root.querySelector<HTMLElement>('[data-current-number]');
      const cue = root.querySelector<HTMLElement>('[data-current-cue]');
      const phaseLabel = root.querySelector<HTMLElement>('[data-phase-label]');

      const paint = () => {
        const current = concepts.find((item) => item.id === active) || concepts[0];
        root.dataset.active = active;
        root.dataset.phase = String(phase);
        tabs.forEach((tab) => {
          const on = tab.dataset.concept === active;
          tab.classList.toggle('is-active', on);
          tab.setAttribute('aria-selected', String(on));
        });
        scenes.forEach((scene) => scene.classList.toggle('is-active', scene.dataset.scene === active));
        phaseButtons.forEach((button) =>
          button.classList.toggle('is-active', Number(button.dataset.phaseButton) === phase)
        );
        if (name) name.textContent = current.name;
        if (number) number.textContent = current.number;
        if (cue) cue.textContent = current.cue;
        if (phaseLabel) phaseLabel.textContent = phaseLabels[active]?.[phase] || '';
        history.replaceState(null, '', `#${active}`);
      };
      const restart = () => {
        window.clearInterval(timer);
        if (playing)
          timer = window.setInterval(() => {
            phase = (phase + 1) % 3;
            paint();
          }, 3800);
      };
      tabs.forEach((tab) =>
        tab.addEventListener('click', () => {
          active = tab.dataset.concept || 'clarte';
          phase = 0;
          paint();
          restart();
        })
      );
      phaseButtons.forEach((button) =>
        button.addEventListener('click', () => {
          phase = Number(button.dataset.phaseButton || 0);
          paint();
          restart();
        })
      );
      playButton?.addEventListener('click', () => {
        playing = !playing;
        playButton.setAttribute('aria-pressed', String(playing));
        const label = playButton.querySelector('span');
        if (label) label.textContent = playing ? 'Animation active' : 'Animation en pause';
        restart();
      });
      const fromHash = location.hash.slice(1);
      if (concepts.some((item) => item.id === fromHash)) active = fromHash;
      const lensWorld = root.querySelector<HTMLElement>('[data-lens-world]');
      lensWorld?.addEventListener('pointermove', (event) => {
        if (active !== 'lentille' || phase === 2) return;
        const rect = lensWorld.getBoundingClientRect();
        lensWorld.style.setProperty('--lx', `${((event.clientX - rect.left) / rect.width) * 100}%`);
        lensWorld.style.setProperty('--ly', `${((event.clientY - rect.top) / rect.height) * 100}%`);
      });
      paint();
      restart();
    };
    document.addEventListener('astro:page-load', setupConceptLab);
    setupConceptLab();
  </script>
</Layout>
