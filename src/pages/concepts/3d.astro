---
import Layout from '~/layouts/Layout.astro';

const metadata = {
  title: 'Laboratoire de concepts 3D',
  description: 'Cinq directions visuelles 3D pour la nouvelle ouverture du site Opti Solution.',
};

const concepts = [
  { id: 'clarte', number: '01', name: 'Clarté optique', cue: 'Le métier se remet au point.' },
  { id: 'magasin', number: '02', name: 'Magasin vivant', cue: 'Chaque zone rejoint le même flux.' },
  { id: 'monture', number: '03', name: 'Une monture, un parcours', cue: 'Le produit garde tout son contexte.' },
  { id: 'lentille', number: '04', name: 'La lentille-interface', cue: 'Déplacez la lentille pour révéler le système.' },
  { id: 'orbite', number: '05', name: 'Système orbital', cue: 'Six métiers. Un seul centre.' },
];
---

<Layout metadata={metadata}>
  <main class="lab" data-concept-lab data-active="clarte" data-phase="0">
    <header class="lab-topbar">
      <a class="brand" href="/" aria-label="Retour à l’accueil Opti Solution">
        <img src="/brand/opti-solution-logo-reversed.svg" alt="Opti Solution" width="219" height="56" />
      </a>
      <p><span>Laboratoire 3D</span> / cinq pistes d’ouverture</p>
      <a class="back-link" href="/">Retour au site <span aria-hidden="true">↗</span></a>
    </header>

    <div class="lab-shell">
      <nav class="concept-nav" aria-label="Choisir un concept">
        <p class="nav-kicker">Directions</p>
        {
          concepts.map((concept, index) => (
            <button
              class:list={['concept-tab', index === 0 && 'is-active']}
              type="button"
              data-concept={concept.id}
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <span>{concept.number}</span>
              <strong>{concept.name}</strong>
              <i aria-hidden="true" />
            </button>
          ))
        }
        <p class="nav-note">Sélectionnez une piste, puis comparez ses trois temps.</p>
      </nav>

      <section class="viewer" aria-live="polite">
        <div class="viewer-head">
          <div>
            <p class="scene-index">CONCEPT <span data-current-number>01</span></p>
            <h1 data-current-name>Clarté optique</h1>
          </div>
          <p class="scene-cue" data-current-cue>Le métier se remet au point.</p>
        </div>

        <div class="stage" data-stage>
          <div class="stage-grain" aria-hidden="true"></div>

          <article class="scene scene--clarte is-active" data-scene="clarte" aria-label="Concept clarté optique">
            <div class="clarity-world">
              <figure
                class="concept-reference-frame"
                aria-label="Premier plan du concept : espace optique premium avec informations dispersées"
              >
                <img
                  src="/concepts/concept-01-frame-01.webp"
                  alt="Boutique d’optique premium avec une lentille centrale, une monture, une fiche client, un devis, un colis fournisseur, une étiquette de stock et un reçu séparés."
                  width="1672"
                  height="941"
                />
              </figure>
              <div class="clarity-glow"></div>
              <div class="desk-plane"></div>
              <div class="floating-object rx-card">
                <span class="object-label">Correction</span>
                <strong>OD&nbsp; −1.25</strong><strong>OG&nbsp; −1.00</strong>
                <small>ADD +2.00</small>
              </div>
              <div class="floating-object product-card">
                <span class="object-label">Référence</span>
                <div class="mini-glasses"><i></i><i></i><b></b></div>
                <strong>MO—2418</strong><small>Écaille / 48□20</small>
              </div>
              <div class="floating-object supplier-box">
                <span class="box-tape"></span><b>AR</b><small>Fournisseur</small>
              </div>
              <div class="floating-object receipt">
                <span>DEVIS</span><b>2 840 DH</b><i></i><i></i><i></i>
              </div>
              <div class="floating-object stock-tag"><small>Stock</small><b>02</b><span>disponibles</span></div>
              <div class="floating-object payment-pill"><i></i> Paiement en attente</div>

              <div class="clarity-dashboard" aria-hidden="true">
                <div class="dash-side">
                  <img src="/brand/opti-solution-mark.svg" alt="" /><i></i><i></i><i></i><i></i>
                </div>
                <div class="dash-body">
                  <div class="dash-top"><span>Fiche client</span><b>Créer un devis</b></div>
                  <div class="dash-profile">
                    <i>NM</i><div><b>Nadia Mansouri</b><span>Dernière visite · aujourd’hui</span></div>
                  </div>
                  <div class="dash-grid">
                    <div><span>CORRECTION</span><b>OD −1.25</b><b>OG −1.00</b></div>
                    <div><span>DEVIS</span><strong>2 840 DH</strong><small>Prêt à confirmer</small></div>
                    <div><span>PRODUIT</span><b>MO—2418</b><small>Stock disponible</small></div>
                  </div>
                </div>
              </div>

              <div class="hero-lens" aria-hidden="true">
                <div class="lens-sheen"></div><div class="lens-caustic"></div>
              </div>
              <div class="focus-rays" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="workflow-orbit orbit--clarity" aria-hidden="true">
                {
                  ['Client', 'OD/OG', 'Devis', 'Fournisseur', 'Stock', 'Vente', 'Paiement'].map((item, index) => (
                    <span style={`--i:${index}`}>{item}</span>
                  ))
                }
                <b></b>
              </div>
            </div>
          </article>

          <article class="scene scene--magasin" data-scene="magasin" aria-label="Concept magasin vivant">
            <div class="shop-world">
              <div class="shop-room">
                <div class="shop-floor"></div>
                <div class="shop-wall shop-wall--left"></div><div class="shop-wall shop-wall--back"></div>
                <div class="shop-zone zone-client">
                  <span>01</span><i class="zone-icon person-icon"></i><b>Client</b>
                </div>
                <div class="shop-zone zone-exam"><span>02</span><i class="zone-icon lens-icon"></i><b>Examen</b></div>
                <div class="shop-zone zone-frames">
                  <span>03</span><i class="zone-icon frame-icon"></i><b>Montures</b>
                </div>
                <div class="shop-zone zone-stock"><span>04</span><i class="zone-icon box-icon"></i><b>Stock</b></div>
                <div class="shop-zone zone-pay"><span>05</span><i class="zone-icon card-icon"></i><b>Caisse</b></div>
                <svg class="shop-lines" viewBox="0 0 800 500" aria-hidden="true">
                  <path d="M126 348 L287 356 L374 232 L558 156 L658 322"></path>
                  <path class="line-lit" d="M126 348 L287 356 L374 232 L558 156 L658 322"></path>
                </svg>
                <div class="shop-core"><img src="/brand/opti-solution-mark.svg" alt="" /></div>
                <div class="data-packet packet-a"></div><div class="data-packet packet-b"></div>
              </div>
              <div class="shop-caption"><span>Vue boutique</span><b>Un magasin, un flux continu</b></div>
            </div>
          </article>

          <article class="scene scene--monture" data-scene="monture" aria-label="Concept une monture, un parcours">
            <div class="frame-world">
              <div class="frame-halo"></div>
              <svg class="hero-frames" viewBox="0 0 900 390" aria-hidden="true">
                <defs>
                  <linearGradient id="metal" x1="0" x2="1"
                    ><stop stop-color="#e2c88f"></stop><stop offset=".45" stop-color="#9b7642"></stop><stop
                      offset=".7"
                      stop-color="#f0dcae"></stop><stop offset="1" stop-color="#8b6736"></stop></linearGradient
                  >
                  <radialGradient id="glass"
                    ><stop stop-color="#dff9f2" stop-opacity=".46"></stop><stop
                      offset="1"
                      stop-color="#84c6b7"
                      stop-opacity=".12"></stop></radialGradient
                  >
                </defs>
                <path class="temple" d="M225 182 C142 160 72 142 22 100"></path><path
                  class="temple"
                  d="M674 182 C758 161 828 142 878 100"></path>
                <path
                  class="frame-rim"
                  d="M103 154 C141 92 290 90 348 151 C369 172 355 260 306 282 C242 312 135 280 108 224 C98 203 95 174 103 154Z"
                ></path>
                <path
                  class="frame-rim"
                  d="M797 154 C759 92 610 90 552 151 C531 172 545 260 594 282 C658 312 765 280 792 224 C802 203 805 174 797 154Z"
                ></path>
                <path
                  class="lens-fill"
                  d="M111 158 C149 103 285 101 338 157 C354 178 342 249 298 270 C239 295 145 270 119 219 C108 198 104 174 111 158Z"
                ></path>
                <path
                  class="lens-fill"
                  d="M789 158 C751 103 615 101 562 157 C546 178 558 249 602 270 C661 295 755 270 781 219 C792 198 796 174 789 158Z"
                ></path>
                <path class="bridge" d="M347 169 C382 130 518 130 553 169"></path><circle
                  cx="450"
                  cy="147"
                  r="5"
                  fill="#d5b571"></circle>
              </svg>
              <div class="spec-chip chip-rx"><span>OD / OG</span><b>−1.25 / −1.00</b></div>
              <div class="spec-chip chip-lens"><span>Verres</span><b>Indice 1.6</b></div>
              <div class="spec-chip chip-price"><span>Prix</span><b>2 840 DH</b></div>
              <div class="spec-chip chip-supplier"><span>Fournisseur</span><b>Atelier R.</b></div>
              <div class="spec-chip chip-stock"><span>Stock</span><b>Disponible</b></div>
              <div class="spec-chip chip-order"><span>Commande</span><b>BC-00482</b></div>
              <div class="product-record">
                <div class="record-head"><span>Fiche liée</span><b>MO—2418</b></div>
                <div class="record-person">
                  <i>NM</i><div><b>Nadia Mansouri</b><span>Client · correction active</span></div>
                </div>
                <div class="record-rows">
                  <span>Monture <b>Écaille 48□20</b></span><span>Verres <b>Indice 1.6</b></span><span
                    >Commande <b>BC-00482</b></span
                  >
                </div>
                <div class="record-status"><i></i> Parcours prêt à finaliser</div>
              </div>
            </div>
          </article>

          <article class="scene scene--lentille" data-scene="lentille" aria-label="Concept lentille interface">
            <div class="lens-world" data-lens-world>
              <div class="lens-message">
                <span>Hors de la lentille</span><b>Les informations restent dispersées.</b>
              </div>
              <div class="interface-blur interface-layer" aria-hidden="true">
                <img src="/working/05-prescription-hero.webp" alt="" />
              </div>
              <div class="interface-focus interface-layer" aria-hidden="true">
                <img src="/working/05-prescription-hero.webp" alt="" />
              </div>
              <div class="moving-lens" aria-hidden="true"><i></i><b></b></div>
              <div class="lens-tooltip"><span>Dans la lentille</span><b>Tout reprend sa place.</b></div>
              <div class="lens-cursor-hint">Déplacez votre souris <span>↗</span></div>
            </div>
          </article>

          <article class="scene scene--orbite" data-scene="orbite" aria-label="Concept système orbital">
            <div class="orbit-world">
              <div class="orbit-aura"></div>
              <div class="orbit-ring ring-a"></div><div class="orbit-ring ring-b"></div><div class="orbit-ring ring-c">
              </div>
              <div class="orbit-core">
                <img src="/brand/opti-solution-mark.svg" alt="" /><b>Opti Solution</b><span>Centre opérationnel</span>
              </div>
              <div class="orbit-node node-client"><i class="person-icon"></i><b>Client</b><span>01</span></div>
              <div class="orbit-node node-optometrie"><i class="lens-icon"></i><b>Optométrie</b><span>02</span></div>
              <div class="orbit-node node-devis"><i class="doc-icon"></i><b>Devis</b><span>03</span></div>
              <div class="orbit-node node-produits"><i class="frame-icon"></i><b>Produits</b><span>04</span></div>
              <div class="orbit-node node-fournisseurs"><i class="box-icon"></i><b>Fournisseurs</b><span>05</span></div>
              <div class="orbit-node node-facturation"><i class="card-icon"></i><b>Facturation</b><span>06</span></div>
              <div class="gold-runner"></div>
              <div class="orbit-caption">
                <span>Le point or suit le parcours</span><b>Chaque opération revient au même système.</b>
              </div>
            </div>
          </article>

          <div class="stage-label"><i></i><span data-phase-label>État fragmenté</span></div>
        </div>

        <div class="viewer-controls">
          <div class="phase-controls" role="group" aria-label="Changer le temps de l’animation">
            <button type="button" class="is-active" data-phase-button="0"><span>01</span> Fragmenté</button>
            <button type="button" data-phase-button="1"><span>02</span> Transition</button>
            <button type="button" data-phase-button="2"><span>03</span> Connecté</button>
          </div>
          <button class="play-control" type="button" data-play aria-pressed="true"
            ><i></i><span>Animation active</span></button
          >
        </div>
      </section>
    </div>
  </main>

  <style is:global>
    :root {
      color-scheme: dark;
    }
    html {
      background: #071e19;
    }
    body {
      margin: 0;
      overflow-x: hidden;
      background: #071e19 !important;
    }
    .lab {
      --forest: #0b2e26;
      --green: #0f3d32;
      --mint: #b7d7cb;
      --cream: #f8f5ed;
      --gold: #c9a96b;
      --ink: #142a25;
      --line: rgb(231 240 235 / 0.16);
      min-height: 100svh;
      color: var(--cream);
      background: radial-gradient(circle at 78% 18%, rgb(36 103 84 / 0.24), transparent 32rem), #071e19;
      font-family: Inter, system-ui, sans-serif;
    }
    .lab button,
    .lab a {
      -webkit-tap-highlight-color: transparent;
    }
    .lab-topbar {
      height: 78px;
      padding: 0 clamp(22px, 4vw, 64px);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      border-bottom: 1px solid var(--line);
      position: relative;
      z-index: 20;
    }
    .brand {
      width: 154px;
      display: inline-flex;
    }
    .brand img {
      width: 100%;
      height: auto;
    }
    .lab-topbar p {
      margin: 0;
      color: rgb(248 245 237 / 0.55);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .lab-topbar p span {
      color: var(--gold);
    }
    .back-link {
      justify-self: end;
      color: var(--cream);
      text-decoration: none;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .back-link span {
      color: var(--gold);
      margin-left: 6px;
    }
    .lab-shell {
      min-height: calc(100svh - 78px);
      display: grid;
      grid-template-columns: 250px 1fr;
    }
    .concept-nav {
      border-right: 1px solid var(--line);
      padding: 42px 24px 30px clamp(24px, 3vw, 50px);
      display: flex;
      flex-direction: column;
    }
    .nav-kicker {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      margin: 0 0 18px;
    }
    .concept-tab {
      width: 100%;
      border: 0;
      border-top: 1px solid var(--line);
      color: rgb(248 245 237 / 0.48);
      background: none;
      text-align: left;
      padding: 17px 4px;
      display: grid;
      grid-template-columns: 25px 1fr 8px;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition-property: color, padding, scale;
      transition-duration: 150ms;
      transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }
    .concept-tab:last-of-type {
      border-bottom: 1px solid var(--line);
    }
    .concept-tab > span {
      font:
        10px ui-monospace,
        monospace;
      color: rgb(201 169 107 / 0.68);
    }
    .concept-tab strong {
      font-size: 12px;
      font-weight: 500;
      line-height: 1.25;
    }
    .concept-tab i {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      transform: scale(0.7);
      transition:
        transform 0.35s ease,
        background 0.35s ease;
    }
    .concept-tab:hover,
    .concept-tab:focus-visible,
    .concept-tab.is-active {
      color: var(--cream);
      padding-left: 10px;
      outline: none;
    }
    .concept-tab.is-active i {
      background: var(--gold);
      box-shadow: 0 0 0 5px rgb(201 169 107 / 0.12);
      transform: scale(1);
    }
    .nav-note {
      margin: auto 0 0;
      max-width: 155px;
      color: rgb(248 245 237 / 0.35);
      font-size: 10px;
      line-height: 1.6;
    }
    .viewer {
      min-width: 0;
      padding: 28px clamp(28px, 4.2vw, 72px) 22px;
      display: grid;
      grid-template-rows: auto auto auto;
      gap: 18px;
    }
    .viewer-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 30px;
    }
    .scene-index {
      margin: 0 0 5px;
      color: var(--gold);
      font:
        9px ui-monospace,
        monospace;
      letter-spacing: 0.18em;
    }
    .viewer-head h1 {
      margin: 0;
      font:
        400 clamp(32px, 4vw, 58px)/0.96 Georgia,
        serif;
      letter-spacing: -0.045em;
    }
    .scene-cue {
      max-width: 290px;
      margin: 0 0 4px;
      color: rgb(248 245 237 / 0.56);
      font:
        italic 18px/1.35 Georgia,
        serif;
      text-align: right;
    }
    .stage {
      min-height: 0;
      aspect-ratio: 16 / 9;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      border: 1px solid rgb(248 245 237 / 0.15);
      border-radius: 24px;
      background: radial-gradient(circle at 52% 47%, #f6f1e5 0, #ded9ca 48%, #bdb8a9 100%);
      box-shadow: 0 35px 100px rgb(0 0 0 / 0.28);
      perspective: 1300px;
    }
    .stage::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / 0.22),
        inset 0 -100px 160px rgb(6 29 24 / 0.1);
      z-index: 15;
      border-radius: inherit;
    }
    .stage-grain {
      position: absolute;
      inset: 0;
      z-index: 14;
      opacity: 0.12;
      pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.25'/%3E%3C/svg%3E");
      mix-blend-mode: soft-light;
    }
    .scene {
      position: absolute;
      inset: 0;
      opacity: 0;
      pointer-events: none;
      transform: scale(0.985);
      transition:
        opacity 0.55s ease,
        transform 0.75s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .scene.is-active {
      opacity: 1;
      pointer-events: auto;
      transform: none;
      z-index: 2;
    }
    .stage-label {
      position: absolute;
      z-index: 18;
      left: 20px;
      bottom: 18px;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 8px 12px;
      border: 1px solid rgb(11 46 38 / 0.13);
      border-radius: 999px;
      color: #25463d;
      background: rgb(248 245 237 / 0.7);
      backdrop-filter: blur(10px);
      font-size: 10px;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }
    .stage-label i {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 0 4px rgb(201 169 107 / 0.2);
    }
    .viewer-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .phase-controls {
      display: flex;
      gap: 6px;
    }
    .phase-controls button,
    .play-control {
      min-height: 44px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: rgb(248 245 237 / 0.5);
      background: transparent;
      padding: 0 16px;
      font-size: 10px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      cursor: pointer;
      transition-property: color, background-color, border-color, scale;
      transition-duration: 150ms;
      transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }
    .phase-controls button span {
      color: var(--gold);
      margin-right: 8px;
      font-family: ui-monospace, monospace;
    }
    .phase-controls button:hover,
    .phase-controls button:focus-visible,
    .phase-controls button.is-active,
    .play-control:hover,
    .play-control:focus-visible {
      color: var(--cream);
      border-color: rgb(248 245 237 / 0.35);
      background: rgb(248 245 237 / 0.07);
      outline: none;
    }
    .play-control {
      display: inline-flex;
      align-items: center;
      gap: 9px;
    }
    .play-control i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow: 0 0 0 4px rgb(201 169 107 / 0.11);
    }
    .play-control[aria-pressed='false'] i {
      background: rgb(248 245 237 / 0.3);
      box-shadow: none;
    }
    .concept-tab:active,
    .phase-controls button:active,
    .play-control:active {
      scale: 0.96;
    }

    /* Concept 01 — scattered work to optical clarity */
    .clarity-world {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      color: var(--ink);
    }
    .concept-reference-frame {
      position: absolute;
      inset: 0;
      z-index: 10;
      margin: 0;
      overflow: hidden;
      background: #b9926b;
      opacity: 1;
      transform: scale(1);
      filter: saturate(0.96) contrast(1.01);
      transition-property: opacity, transform, filter;
      transition-duration: 900ms;
      transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }
    .concept-reference-frame::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, transparent 68%, rgb(31 23 16 / 0.14));
    }
    .concept-reference-frame img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      outline: 1px solid oklch(1 0 0 / 0.1);
      outline-offset: -1px;
    }
    .clarity-glow {
      position: absolute;
      width: 40%;
      aspect-ratio: 1;
      left: 30%;
      top: 15%;
      border-radius: 50%;
      background: radial-gradient(circle, rgb(255 255 255 / 0.85), transparent 68%);
      filter: blur(14px);
    }
    .desk-plane {
      position: absolute;
      width: 86%;
      height: 62%;
      left: 7%;
      top: 24%;
      border: 1px solid rgb(15 61 50 / 0.13);
