      top: 348px;
    }
    .packet-b {
      left: 375px;
      top: 232px;
    }
    .shop-caption {
      position: absolute;
      right: 24px;
      bottom: 22px;
      text-align: right;
      color: #26483e;
    }
    .shop-caption span {
      display: block;
      font-size: 7px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #806735;
    }
    .shop-caption b {
      display: block;
      margin-top: 4px;
      font: italic 16px Georgia;
    }
    .lab[data-active='magasin'][data-phase='1'] .shop-room {
      transform: translate(-50%, -50%) rotateX(56deg) rotateZ(-32deg) scale(0.88);
    }
    .lab[data-active='magasin'][data-phase='1'] .shop-zone {
      box-shadow: 12px 18px 38px rgb(34 80 68 / 0.22);
    }
    .lab[data-active='magasin'][data-phase='1'] .shop-lines .line-lit {
      opacity: 0.55;
    }
    .lab[data-active='magasin'][data-phase='1'] .shop-core {
      opacity: 1;
      transform: translateZ(74px) rotateZ(32deg) rotateX(-56deg) scale(0.82);
    }
    .lab[data-active='magasin'][data-phase='2'] .shop-room {
      transform: translate(-50%, -50%) rotateX(54deg) rotateZ(-32deg) scale(0.92);
    }
    .lab[data-active='magasin'][data-phase='2'] .shop-lines .line-lit {
      opacity: 1;
    }
    .lab[data-active='magasin'][data-phase='2'] .shop-core {
      opacity: 1;
      transform: translateZ(82px) rotateZ(32deg) rotateX(-54deg) scale(1);
    }
    .lab[data-active='magasin'][data-phase='2'] .data-packet {
      opacity: 1;
      animation: packet 3.5s ease-in-out infinite alternate;
    }
    .lab[data-active='magasin'][data-phase='2'] .packet-b {
      animation-delay: -1.6s;
    }
    @keyframes packet {
      to {
        translate: 280px -118px;
      }
    }

    /* Concept 03 — a frame's complete journey */
    .frame-world {
      position: absolute;
      inset: 0;
      color: var(--ink);
      transform-style: preserve-3d;
      overflow: hidden;
    }
    .frame-halo {
      position: absolute;
      width: 560px;
      height: 310px;
      border-radius: 50%;
      left: 50%;
      top: 48%;
      translate: -50% -50%;
      background: radial-gradient(circle, rgb(255 255 255 / 0.9), rgb(218 239 232 / 0.25) 48%, transparent 70%);
      filter: blur(10px);
    }
    .hero-frames {
      position: absolute;
      z-index: 3;
      width: min(710px, 70%);
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%) rotateX(8deg) rotateY(-8deg) translateZ(80px);
      filter: drop-shadow(0 28px 23px rgb(34 49 45 / 0.21));
      transition: 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .frame-rim,
    .bridge,
    .temple {
      fill: none;
      stroke: url(#metal);
      stroke-width: 12;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .temple {
      stroke-width: 9;
    }
    .lens-fill {
      fill: url(#glass);
      stroke: rgb(255 255 255 / 0.65);
      stroke-width: 2;
    }
    .spec-chip {
      position: absolute;
      z-index: 5;
      min-width: 110px;
      padding: 10px 12px;
      border: 1px solid rgb(15 61 50 / 0.14);
      border-radius: 9px;
      background: rgb(255 254 249 / 0.82);
      box-shadow: 0 16px 30px rgb(33 58 51 / 0.13);
