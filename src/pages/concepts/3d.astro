      height: 11px;
      border-radius: 50%;
      background: var(--gold);
      box-shadow:
        0 0 0 7px rgb(201 169 107 / 0.15),
        0 0 18px #c9a96b;
      transform: translateZ(62px);
      opacity: 0;
    }
    .packet-a {
