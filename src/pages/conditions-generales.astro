---
import LegalPage, { type LegalSection } from '~/components/site/LegalPage.astro';

const sections: LegalSection[] = [
  {
    title: 'Objet et documents applicables',
    paragraphs: [
      'Les présentes conditions présentent le cadre général dans lequel Opti Solution peut fournir une démonstration, une étude, une configuration, un déploiement, une formation, un support ou une adaptation logicielle à un client professionnel.',
