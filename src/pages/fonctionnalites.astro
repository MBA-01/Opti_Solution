---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import SectionIntro from '~/components/site/SectionIntro.astro';
import FinalCTA from '~/components/site/FinalCTA.astro';
import ScreenshotFrame from '~/components/ui/ScreenshotFrame.astro';
import EvidencePlaceholder from '~/components/site/EvidencePlaceholder.astro';
import { capabilityGroups } from '~/data/optic-site';

const metadata = {
  title: 'Fonctionnalités',
  description: 'Explorez les fonctionnalités d’OptiSolution par domaine de travail du magasin d’optique.',
};
---

<MarketingLayout metadata={metadata}>
  <PageHero
    chapter="03 · Fonctionnalités"
    title="Les bons outils, au bon moment."
    text="Explorez OptiSolution par activité : fiche optique, vente, produits, achats, facturation et configuration. Chaque domaine présente ses tâches et les points à vérifier pendant la démonstration."
    secondaryText="Suivre le parcours complet"
    secondaryHref="/fonctionnement"
  >
    <div slot="visual">
      <EvidencePlaceholder
        label="Démonstration guidée"
        title="Produits & stock"
        text="La capture publique du catalogue reste retirée. La démonstration utilise un jeu de données préparé."
      />
    </div>
  </PageHero>

  <section class="os-section">
    <div class="os-container">
      <SectionIntro
        title="Six domaines qui couvrent le parcours principal du magasin."
        text="Passez d’une vue d’ensemble aux tâches concrètes, puis utilisez la démonstration pour vérifier leur adéquation avec votre organisation."
      />
      {
        capabilityGroups.map((group) => (
          <article class="os-feature-band" id={group.slug}>
            <div class="os-feature-band__copy">
              <>
                <p class="os-kicker">{group.kicker}</p>
                <h2>{group.title}</h2>
                <p>{group.description}</p>
              </>
              <ul class="os-task-list">
                {group.tasks.map((task) => (
                  <li>{task}</li>
                ))}
              </ul>
            </div>
            {group.image ? (
              <ScreenshotFrame
                src={group.image}
                alt={group.imageAlt}
                label={group.kicker}
                caption={`${group.title} · extrait validé`}
                href={group.image}
                fit="contain"
              />
            ) : (
              <EvidencePlaceholder title={group.title} />
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="os-section os-section--dark">
    <div class="os-container os-difference">
      <p class="os-difference__statement">Une solution compréhensible avant même la démonstration.</p>
      <div class="os-difference__notes">
        <div>
          <strong>Des validations explicites</strong><p>
            L’équipe vérifie les informations avant de confirmer les documents et les opérations sensibles.
          </p>
        </div>
        <div>
          <strong>Un périmètre sans ambiguïté</strong><p>
            Hébergement, migration, support et adaptations sont détaillés dans la proposition lorsqu’ils sont retenus.
          </p>
        </div>
        <div>
          <strong>Le produit reste la meilleure preuve</strong><p>
            Les extraits publiés sont limités aux états validés. Les autres vues sont montrées pendant la démonstration.
          </p>
        </div>
      </div>
    </div>
  </section>
  <FinalCTA
    title="Choisissons les fonctionnalités à montrer."
    text="La démo peut se concentrer sur les domaines les plus proches du travail de votre équipe."
  />
</MarketingLayout>
