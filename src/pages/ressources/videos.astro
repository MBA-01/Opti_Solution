---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import SectionIntro from '~/components/site/SectionIntro.astro';
import FinalCTA from '~/components/site/FinalCTA.astro';
import VideoPlaceholder from '~/components/site/VideoPlaceholder.astro';
import ScreenshotFrame from '~/components/ui/ScreenshotFrame.astro';

const metadata = {
  title: 'Vidéos et démonstrations',
  description:
    'Découvrez les parcours Opti Solution à travers des démonstrations guidées et de futures vidéos courtes.',
};

const videoTopics = [
  {
    title: 'Créer une fiche et saisir une correction',
    description: 'Passer de la fiche client aux valeurs OD/OG, puis contrôler les informations avant validation.',
    poster: '/working/05-prescription-review.webp',
    category: 'Clients & optométrie',
    related: '/fonctionnalites#clients-optometrie',
  },
  {
    title: 'Préparer un devis client',
    description: 'Ajouter les produits, relire les quantités et montants, puis confirmer le document au bon moment.',
    poster: '/working/03-prescription-distance.webp',
    category: 'Ventes & devis',
    related: '/fonctionnalites#ventes-devis',
  },
  {
    title: 'Lire une fiche produit',
    description: 'Retrouver une référence, sa marque, sa catégorie et les informations utiles aux ventes et achats.',
    poster: '/working/02-product-catalog.webp',
    category: 'Produits & stock',
    related: '/fonctionnalites#produits-stock',
  },
  {
    title: 'Préparer une demande de prix fournisseur',
    description: 'Vérifier le fournisseur, les références et les quantités avant de confirmer la commande.',
    poster: '/working/06-supplier-rfq.webp',
    category: 'Fournisseurs & achats',
    related: '/fonctionnalites#fournisseurs-achats',
  },
  {
    title: 'Suivre une réception fournisseur',
    description: 'Comparer la réception avec la commande et repérer les quantités qui demandent une vérification.',
    poster: '/working/07-purchase-reception.webp',
    category: 'Fournisseurs & achats',
    related: '/fonctionnalites#fournisseurs-achats',
  },
  {
    title: 'Retrouver une facture et son règlement',
    description: 'Contrôler les montants et consulter le statut de règlement dans le parcours concerné.',
    poster: '/working/08-supplier-bill.webp',
    category: 'Facturation & paiements',
    related: '/fonctionnalites#facturation-paiements',
  },
];
---

<MarketingLayout metadata={metadata}>
  <PageHero
    chapter="Ressources · Vidéos"
    eyebrow="Le produit en mouvement"
    title="Comprenez une opération en quelques étapes visibles."
    text="La vidéothèque est organisée par tâche afin de vous aider à choisir le parcours à voir pendant une démonstration guidée. Les vidéos publiées ne démarreront jamais automatiquement."
    primaryText="Demander une démo"
    primaryHref="/demo#demande"
    secondaryText="Voir tous les guides"
    secondaryHref="/ressources"
  >
    <ScreenshotFrame
      slot="visual"
      src="/working/05-prescription-hero.webp"
      alt="Aperçu d’une correction optique utilisée comme support de démonstration."
      label="Démonstration produit"
      caption="Fiche client et correction optique"
      href="/working/05-prescription-hero.webp"
    />
  </PageHero>

  <section class="os-section">
    <div class="os-container">
      <SectionIntro
        eyebrow="Bibliothèque"
        title="Choisissez le parcours qui répond à votre question."
        text="Chaque sujet présente une tâche précise et renvoie vers le domaine fonctionnel correspondant. Les enregistrements publics seront ajoutés après leur revue."
      />
      <div class="os-video-grid">
        {
          videoTopics.map((video) => (
            <div>
              <VideoPlaceholder title={video.title} description={video.description} poster={video.poster} />
              <a class="os-text-link mt-4 inline-flex" href={video.related}>
                Voir {video.category} →
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="os-section os-section--dark">
    <div class="os-container os-difference">
      <p class="os-difference__statement">Une démonstration utile répond à une question précise du magasin.</p>
      <div class="os-difference__notes">
        <div>
          <strong>Un sujet par séquence</strong><p>
            Chaque vidéo se concentre sur une opération et les contrôles associés.
          </p>
        </div>
        <div>
          <strong>Le produit reste visible</strong><p>
            Les démonstrations utilisent les interfaces d’Opti Solution et des données préparées.
          </p>
        </div>
        <div>
          <strong>Le contexte est expliqué</strong><p>
            La vidéo distingue les liens entre étapes des décisions qui restent à prendre par l’équipe.
          </p>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    title="Vous souhaitez voir un parcours avant sa publication en vidéo ?"
    text="Indiquez-nous l’opération qui vous intéresse et nous la reprendrons pendant une démonstration guidée."
  />
</MarketingLayout>
