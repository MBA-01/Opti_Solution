---
import MarketingLayout from '~/layouts/MarketingLayout.astro';
import PageHero from '~/components/site/PageHero.astro';
import SectionIntro from '~/components/site/SectionIntro.astro';
import FinalCTA from '~/components/site/FinalCTA.astro';
import ScreenshotFrame from '~/components/ui/ScreenshotFrame.astro';
import Button from '~/components/ui/Button.astro';

const roles = [
  ['Vente', 'Retrouver le client, préparer son devis et suivre les documents commerciaux jusqu’au règlement.'],
  ['Optométrie', 'Saisir les mesures et caractéristiques de verres, puis contrôler la correction avant validation.'],
  ['Achats & stock', 'Préparer les demandes de prix, suivre les commandes, les réceptions et les références produit.'],
  ['Responsable', 'Garder une vue sur les documents, les exceptions et les accès nécessaires à chaque rôle.'],
];
const systemAreas = [
  ['Fiche client', 'Retrouvez les coordonnées, les documents et le contexte utile avant de poursuivre.'],
  ['Fiche optique', 'Structurez les valeurs OD/OG, la vision de loin ou de près, les lentilles et leurs références.'],
  ['Parcours commercial', 'Préparez le devis, puis suivez la commande, la livraison, la facture et le règlement.'],
  [
    'Approvisionnement',
    'Gardez le lien entre fournisseur, demande de prix, commande, réception et facture fournisseur.',
  ],
];
const metadata = {
  title: 'La solution',
  description: 'Comprendre Opti Solution, son rôle dans un magasin d’optique et les domaines de travail couverts.',
};
---

<MarketingLayout metadata={metadata}>
  <PageHero
    chapter="01 · Solution"
    eyebrow="Un environnement de travail"
    title="Reliez la fiche optique aux opérations de votre magasin."
    text="Opti Solution réunit les informations clients, les corrections et les documents de gestion dans un environnement Odoo configuré selon le périmètre de votre magasin."
    secondaryText="Voir le fonctionnement"
    secondaryHref="/fonctionnement"
  >
    <ScreenshotFrame
      slot="visual"
      src="/working/01-client-record.webp"
      alt="Fiche client réelle dans Opti Solution avec données masquées."
      label="Produit réel"
      caption="La fiche client et l’accès aux informations optiques"
      href="/working/01-client-record.webp"
    />
  </PageHero>

  <section class="os-section">
    <div class="os-container os-split">
      <div>
        <p class="os-eyebrow">Ce qu’est Opti Solution</p>
        <h2 class="text-[clamp(2.5rem,5vw,4.8rem)] leading-none font-serif tracking-[-0.045em]">
          Une fiche qui accompagne le travail, de l’accueil à l’approvisionnement.
        </h2>
      </div>
      <div class="os-problem-list">
        {
          systemAreas.map(([title, text], index) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="os-section os-section--dark">
    <div class="os-container">
      <SectionIntro
        eyebrow="Pour qui"
        title="Chaque rôle retrouve son travail sans perdre le contexte."
        text="Les accès et responsabilités sont définis avec vous. Vente, optométrie, achats et gestion peuvent ainsi travailler dans un cadre commun."
      />
      <div class="os-capability-preview os-capability-preview--roles">
        {
          roles.slice(0, 3).map(([title, text], index) => (
            <article class="!bg-transparent !border-white/15">
              <div class="os-capability-preview__copy">
                <>
                  <p class="os-kicker">Rôle 0{index + 1}</p>
                  <h3 class="!text-white">{title}</h3>
                  <p class="!text-white/65">{text}</p>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <div class="os-workflow-note !bg-white/5 !border-[var(--os-gold-400)]">
        <strong class="!text-[var(--os-gold-400)]">Responsable</strong><span class="text-white/70">{roles[3][1]}</span>
      </div>
    </div>
  </section>

  <section class="os-section os-section--cream">
    <div class="os-container">
      <SectionIntro
        eyebrow="Comment la solution s’insère"
        title="L’information utile reste proche de l’opération suivante."
        text="Opti Solution aide l’équipe à retrouver le contexte et à préparer la suite. Les décisions et validations restent explicites à chaque étape."
      />
      <div class="os-split">
        <ScreenshotFrame
          src="/working/05-prescription-review.webp"
          alt="Correction optique validée dans l’interface Odoo."
          label="Correction"
          caption="Valeurs optiques et caractéristiques de verres"
          href="/working/05-prescription-review.webp"
        />
        <div>
          <p class="os-eyebrow">Votre équipe reste décisionnaire</p>
          <h2 class="text-4xl leading-tight font-serif">
            Préparer plus clairement. Confirmer en connaissance de cause.
          </h2>
          <p class="os-lead mt-5">
            Une correction validée peut aider à préparer des lignes de vente ou d’achat en brouillon selon la
            configuration. Les documents, prix, taxes, quantités et références restent à vérifier avant confirmation.
          </p>
          <div class="os-actions">
            <Button
              variant="secondary"
              href="/fonctionnement"
              text="Voir les étapes de contrôle"
              icon="tabler:arrow-right"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="os-section">
    <div class="os-container os-offer-preview">
      <div>
        <p class="os-eyebrow">Une configuration définie</p>
        <h2 class="text-[clamp(2.5rem,5vw,4.5rem)] leading-none font-serif tracking-[-0.045em]">
          Une base prête à être configurée pour votre périmètre.
        </h2>
      </div>
      <div class="os-problem-list">
        <article>
          <span>01</span><div>
            <h3>Configuration initiale</h3><p>
              Les modules, référentiels, rôles et réglages utiles sont définis dans la proposition.
            </p>
          </div>
        </article>
        <article>
          <span>02</span><div>
            <h3>Déploiement</h3><p>
              Un environnement VPS/cloud ou local peut être étudié selon vos contraintes et votre budget.
            </p>
          </div>
        </article>
        <article>
          <span>03</span><div>
            <h3>Adaptations optionnelles</h3><p>
              Les besoins qui dépassent la configuration standard sont étudiés et chiffrés séparément.
            </p>
          </div>
        </article>
        <a class="os-text-link mt-6" href="/mise-en-place">Comprendre la mise en place →</a>
      </div>
    </div>
  </section>
  <FinalCTA />
</MarketingLayout>
